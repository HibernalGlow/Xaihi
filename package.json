{
  "name": "xaihi-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "description": "Xaihi: a workspace extension framework and domain node ecosystem for DeepSeek Harness.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test:unit": "pnpm -r --no-bail run test:unit",
    "check:pins": "node scripts/check-pins.mjs",
    "test": "pnpm check:pins && pnpm -r run build && pnpm -r run typecheck && pnpm -r --no-bail run test:unit",
    "dsh": "pnpm exec dsh"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  }
}
