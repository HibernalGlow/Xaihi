{
  "name": "xaihi-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "description": "Xaihi: a workspace extension framework and domain node ecosystem for DeepSeek Harness.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test:unit": "pnpm -r --no-bail run test:unit",
    "check:pins": "node scripts/check-pins.mjs --self-check && node scripts/check-pins.mjs",
    "check:installable": "node scripts/check-installable.mjs --self-check && node scripts/check-installable.mjs",
    "check:vocab": "node scripts/check-vocab.mjs --self-check && node scripts/check-vocab.mjs",
    "check:vendored": "node scripts/check-vendored.mjs --self-check && node scripts/check-vendored.mjs",
    "check:cliregistry": "node scripts/gen-cli-registry.mjs --self-check && node scripts/gen-cli-registry.mjs --check",
    "check:noderegistry": "node scripts/gen-node-registry.mjs --check",
    "check:cliface": "node scripts/check-cli-face.mjs --self-check && node scripts/check-cli-face.mjs",
    "check:tuiface": "node scripts/check-tui-face.mjs --self-check && node scripts/check-tui-face.mjs",
    "test:contract": "vitest run packages/contract/src",
    "check:nodebundle": "node scripts/check-node-bundle.mjs --self-check && node scripts/check-node-bundle.mjs",
    "measure:tipbuild": "node scripts/tip-build-check.mjs",
    "test": "pnpm check:pins && pnpm check:skills && pnpm check:installable && pnpm check:vocab && pnpm check:vendored && pnpm check:cliregistry && pnpm check:noderegistry && pnpm test:contract && pnpm -r run build && pnpm check:nodebundle && pnpm check:cliface && pnpm check:tuiface && pnpm -r run typecheck && pnpm -r --no-bail run test:unit",
    "dsh": "pnpm exec dsh",
    "host": "DSH_HOME=$PWD/../.scratch/dsh-xaihi-home pnpm exec dsh --profile xaihi --no-open",
    "host:headless": "DSH_HOME=$PWD/../.scratch/dsh-xaihi-home pnpm exec dsh xaihi-headless",
    "plugin:add": "DSH_HOME=$PWD/../.scratch/dsh-xaihi-home pnpm exec dsh plugin --profile xaihi add",
    "profile:dump": "DSH_HOME=$PWD/../.scratch/dsh-xaihi-home pnpm exec dsh --profile xaihi --dump-config",
    "plugin:install": "DSH_HOME=$PWD/../.scratch/dsh-xaihi-home pnpm exec dsh plugin --profile xaihi install",
    "plugin:remove": "DSH_HOME=$PWD/../.scratch/dsh-xaihi-home pnpm exec dsh plugin --profile xaihi remove",
    "check:skills": "node scripts/check-skills.mjs --self-check && node scripts/check-skills.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
