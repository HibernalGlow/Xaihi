+/**
+ * Xaihi patch 0014: 窗控动作与结果，逐字照基线
+ * `Xiranite/src/backend/runtime/runtime.ts:84` 的 `MainWindowAction` 与 `:102-108` 的 `WindowCommandResult`。
+ *
+ * 为什么结果里必须有 `supported`：那台机器上有些动作**在这套壳里就是没有**
+ * （比如无边框拖拽 —— 我们的窗 `frameless=false`）。缺了这个位，界面只能把"没做成"
+ * 读成"做成了但没变化"，那正是决定 4 禁止的那种静默。
+ */
+export type XaihiWindowAction = 'minimize' | 'maximize' | 'toggle-fullscreen' | 'restore' | 'close'
+
+const WINDOW_ACTIONS: readonly string[] = ['minimize', 'maximize', 'toggle-fullscreen', 'restore', 'close']
+
+/** 只认基线那五个词；不认的词返回 `undefined`，由调用方按形状错误拒（不许猜近义）。 */
+export function normalizeXaihiWindowAction (action: unknown): XaihiWindowAction | undefined {
+  return typeof action === 'string' && WINDOW_ACTIONS.includes(action) ? action as XaihiWindowAction : undefined
+}
+
+/** 一条窗控的结果；`state` 是**做完之后量出来的**，不是"我以为会变成"的那个。 */
+export interface XaihiWindowCommandResult {
+  readonly success: boolean
+  readonly supported: boolean
+  readonly windowId?: number
+  readonly message: string
+  readonly state?: 'normal' | 'maximized' | 'fullscreen' | 'minimized' | 'closed'
+}
+
+/**
+ * 把窗的三个布尔位归成一个状态。顺序是**最小化优先**：mac 上缩到 Dock 的窗可能同时仍报
+ * `isMaximized()`，先问最大化就会把"最小化"报成"最大化"。哪个顺序对不靠猜 ——
+ * `desktop/live-check.mjs` 的 P 段先 `minimize` 再读 `state`，报错了那条就红。
+ * @param flags - the live Electron window flags.
+ * @returns the state a caller can render.
+ */
+export function xaihiWindowState (flags: { minimized: boolean, maximized: boolean, fullscreen: boolean }): 'normal' | 'maximized' | 'fullscreen' | 'minimized' {
+  if (flags.minimized) return 'minimized'
+  if (flags.fullscreen) return 'fullscreen'
+  return flags.maximized ? 'maximized' : 'normal'
+}
+
 /** 一条窗的位置与尺寸；`x`/`y` 是屏幕坐标，可以带符号。 */
 export interface XaihiWindowBounds extends XaihiWindowSize {
   readonly x: number
