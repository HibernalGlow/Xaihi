From 78259e59be740c7813beb22aa19bf52ab5efbfbc Mon Sep 17 00:00:00 2001
From: HibernalGlow <3090253564@qq.com>
Date: Sun, 11 Oct 2026 18:30:00 +0800
Subject: [PATCH] desktop: name Xaihi product dev app and retain native binding
 (Xaihi patch 0020)

The generated macOS development app is also launched directly by Finder or
Launch Services. Give the bundle the product display name and persist the
product's validated native environment name and path so a cold start retains
the Rust Node-API binding.

This is the desktop shell side of the Kisaki product; it does not alter the
bundle contract. The product launcher supplies the display name, environment
name, and path through the generic development script.

---
 apps/desktop/scripts/dev.ts             |  5 ++++-
 apps/desktop/scripts/development-app.ts | 22 ++++++++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/scripts/dev.ts b/apps/desktop/scripts/dev.ts
index 713d11f..58d03d0 100644
--- a/apps/desktop/scripts/dev.ts
+++ b/apps/desktop/scripts/dev.ts
@@ -80,7 +80,10 @@ async function launchElectron(): Promise<void> {
     const executable = prepareDevelopmentApp({ electron, appRoot: APP_ROOT, directory: DEVELOPMENT_ROOT, home, userData,
       mainPort, rendererPort, hostPort, openDevtools: environment.DSH_DESKTOP_OPEN_DEVTOOLS!,
       primaryRuntimeDir: environment.DSH_DESKTOP_PRIMARY_RUNTIME_DIR,
-      profile: process.env.XAIHI_DESKTOP_PROFILE })
+      profile: process.env.XAIHI_DESKTOP_PROFILE,
+      nativeEnvironment: process.env.XAIHI_DESKTOP_NATIVE_ENVIRONMENT,
+      nativePath: process.env.XAIHI_DESKTOP_NATIVE_PATH,
+      appName: process.env.XAIHI_DESKTOP_PRODUCT_TITLE })
     await run(executable, [], APP_ROOT, environment)
     return
   }
diff --git a/apps/desktop/scripts/development-app.ts b/apps/desktop/scripts/development-app.ts
index 7c517dc..615f2eb 100644
--- a/apps/desktop/scripts/development-app.ts
+++ b/apps/desktop/scripts/development-app.ts
@@ -17,6 +17,11 @@ export interface DevelopmentAppOptions {
   readonly openDevtools: string
   readonly primaryRuntimeDir?: string
   readonly profile?: string
+  /** Product-specific native binding environment persisted for Launch Services starts. */
+  readonly nativeEnvironment?: string
+  readonly nativePath?: string
+  /** Product display name used for the generated .app bundle. */
+  readonly appName?: string
 }
 
 function quote(value: string): string { return `'${value.replaceAll("'", "'\\''")}'` }
@@ -28,8 +33,13 @@ function quote(value: string): string { return `'${value.replaceAll("'", "'\\''"
  */
 export function prepareDevelopmentApp(options: DevelopmentAppOptions): string {
   const source = dirname(dirname(dirname(options.electron)))
-  const bundle = join(options.directory, 'Harness Dev.app')
-  const executable = join(bundle, 'Contents', 'MacOS', 'HarnessDev')
+  const appName = options.appName?.trim() || 'Harness Dev'
+  if (!/^[\p{L}\p{N}][\p{L}\p{N} ._-]{0,63}$/u.test(appName)) {
+    throw new Error('desktop development: appName contains unsupported characters')
+  }
+  const executableName = `${appName.replaceAll(/[^A-Za-z0-9]+/g, '') || 'Harness'}Dev`
+  const bundle = join(options.directory, `${appName}.app`)
+  const executable = join(bundle, 'Contents', 'MacOS', executableName)
   const stamp = join(bundle, 'Contents', 'Resources', 'dsh-development.json')
   const launcher = developmentLauncher(options, bundle)
   const identity = JSON.stringify({ ...options, launcher, plist: readFileSync(join(source, 'Contents', 'Info.plist'), 'utf8') })
@@ -39,9 +49,9 @@ export function prepareDevelopmentApp(options: DevelopmentAppOptions): string {
     const plist = join(bundle, 'Contents', 'Info.plist')
     const values = {
       CFBundleIdentifier: `com.deepseek.harness.dev.${createHash('sha256').update(options.appRoot).digest('hex').slice(0, 12)}`,
-      CFBundleName: 'Harness Dev',
-      CFBundleDisplayName: 'Harness Dev',
-      CFBundleExecutable: 'HarnessDev',
+      CFBundleName: appName,
+      CFBundleDisplayName: appName,
+      CFBundleExecutable: executableName,
       CFBundleURLTypes: [{ CFBundleURLName: 'DeepSeek Harness', CFBundleURLSchemes: ['dsh'], CFBundleTypeRole: 'Viewer' }],
     }
     for (const [key, value] of Object.entries(values)) {
@@ -75,6 +85,15 @@ export function developmentLauncher(options: DevelopmentAppOptions, bundle: stri
   if (options.profile !== undefined && options.profile !== '') {
     environment.XAIHI_DESKTOP_PROFILE = options.profile
   }
+  if (options.nativeEnvironment !== undefined || options.nativePath !== undefined) {
+    if (options.nativeEnvironment === undefined || !/^[A-Z][A-Z0-9_]*$/.test(options.nativeEnvironment)) {
+      throw new Error('desktop development: nativeEnvironment must be an uppercase environment variable name')
+    }
+    if (options.nativePath === undefined || options.nativePath === '') {
+      throw new Error('desktop development: nativePath is required when nativeEnvironment is set')
+    }
+    environment[options.nativeEnvironment] = options.nativePath
+  }
   const args = [
     join(bundle, 'Contents', 'MacOS', 'Electron'),
     `--inspect=127.0.0.1:${String(options.mainPort)}`,
