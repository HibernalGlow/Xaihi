diff --git a/apps/desktop/src/main.ts b/apps/desktop/src/main.ts
index f70d268..298db1e 100644
--- a/apps/desktop/src/main.ts
+++ b/apps/desktop/src/main.ts
@@ -922,7 +922,7 @@ async function main(): Promise<void> {
         const next = !target.isFullScreen()
         if (next && target.isMaximized()) target.unmaximize()
         target.setFullScreen(next)
-        const engaged = await waitFlag(() => target.isFullScreen() === next, 2500)
+        const engaged = await waitFlag(() => target.isFullScreen() === next, 8000)
         if (!engaged && !target.isDestroyed()) {
           // 没做成就说没做成。回 success:true 是决定 4 明令禁止的那种"成功但什么都没发生"。
           return { success: false, supported: true, windowId: id, state: stateOf(target), message: 'xaihi desktop: fullscreen did not engage' }
