       closeWindow: revision => ipcRenderer.invoke(DESKTOP_IPC.shortcutsCloseWindow, revision) as Promise<void>,
diff --git a/apps/desktop/src/xaihi-window-policy.ts b/apps/desktop/src/xaihi-window-policy.ts
index b6845cd..d1a626b 100644
--- a/apps/desktop/src/xaihi-window-policy.ts
+++ b/apps/desktop/src/xaihi-window-policy.ts
@@ -116,3 +116,29 @@ export function normalizeXaihiWindowSize (size: unknown): XaihiWindowSize | unde
   if (width > MAX_WINDOW_SIZE || height > MAX_WINDOW_SIZE) return undefined
   return { width, height }
 }
+
+/** 一条窗的位置与尺寸；`x`/`y` 是屏幕坐标，可以带符号。 */
+export interface XaihiWindowBounds extends XaihiWindowSize {
+  readonly x: number
+  readonly y: number
+}
+
+const MAX_WINDOW_ORIGIN = 100000
+
+/**
+ * Xaihi patch 0010: 纯校验一次 `setBounds` 请求。
+ * 尺寸那一半复用 0009 那条（同一个下界/上界，别在两个地方各写一遍数），
+ * 坐标只收**有限整数**且不超一个宽屏合理范围 —— 目的是把 `"120"`、`NaN`、
+ * 半套字段这类调用方错误在壳门口拒掉，而不是让它们变成一次静默的 `setBounds(undefined)`。
+ * @param bounds - the caller-supplied rectangle.
+ * @returns the normalized rectangle, or `undefined` when it is unusable.
+ */
+export function normalizeXaihiWindowBounds (bounds: unknown): XaihiWindowBounds | undefined {
+  const size = normalizeXaihiWindowSize(bounds)
+  if (size === undefined) return undefined
+  const { x, y } = bounds as { x?: unknown, y?: unknown }
+  if (typeof x !== 'number' || typeof y !== 'number') return undefined
+  if (!Number.isInteger(x) || !Number.isInteger(y)) return undefined
+  if (Math.abs(x) > MAX_WINDOW_ORIGIN || Math.abs(y) > MAX_WINDOW_ORIGIN) return undefined
+  return { x, y, width: size.width, height: size.height }
+}
