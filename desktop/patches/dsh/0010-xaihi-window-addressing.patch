 import { DesktopProjectManager } from './project-manager.ts'
 import { DesktopHostFatalError, DesktopHostProcess, DesktopHostUncleanExitError } from './host-process.ts'
@@ -220,6 +220,19 @@ function xaihiOwnedSender (sender: WebContents): boolean {
   return false
 }
 
+/**
+ * Xaihi patch 0010: 按 id 找**我们自己登记过**的文档窗。
+ * 只认这张表 ⇒ `focus/close/getBounds/setBounds` 永远够不到产品主窗、欢迎窗或别人开的窗：
+ * 调用方猜中一个 id 也拿不到不属于 Xaihi 的那一个。
+ */
+function xaihiWindowById (windowId: number): BrowserWindow | undefined {
+  for (const window of xaihiDocumentWindows.values()) {
+    if (window.isDestroyed()) continue
+    if (window.id === windowId) return window
+  }
+  return undefined
+}
+
 export interface XaihiWindowOpening {
   readonly window: BrowserWindow
   readonly alreadyOpen: boolean
@@ -773,7 +786,9 @@ async function main(): Promise<void> {
   // 壳不另开一份存储；这里只做纯校验，半套尺寸（只有 width 或只有 height）按形状错误拒。
   const XAIHI_NODE_PATTERN = /^[a-z0-9][a-z0-9_-]{0,63}$/u
   const XAIHI_DOCUMENT_PATH = /^\/xaihi\/ui\/[0-9a-f]{12}\/index\.html$/u
-  ipcMain.handle(DESKTOP_IPC.xaihiWindowOpen, (event, node: unknown, input?: unknown) => {
+  // 开窗与寻址共用那条发起者闸：域内、主帧，且是产品主窗或某个活着的自家文档窗。
+  // 它放在这个作用域里，是因为 `mainWindow` 是这里的局部量（顶层函数看不见它）。
+  const assertXaihiWindowSender = (event: IpcMainInvokeEvent): boolean => {
     assertDesktopSender(event, ['app'])
     const frame = event.senderFrame
     if (frame === null || frame !== event.sender.mainFrame) {
@@ -783,6 +798,25 @@ async function main(): Promise<void> {
     if (!isMainDocument && !xaihiOwnedSender(event.sender)) {
       throw new Error('xaihi desktop: rejected window request from an unowned renderer')
     }
+    return isMainDocument
+  }
+  // Xaihi patch 0010: `windowId` 必须是整数，且指得到我们自己登记的那张表里的窗。
+  // "unknown window" 这一格是给调用方的真话：它猜中的是别人的窗，不是我们没有窗。
+  const needXaihiWindow = (event: IpcMainInvokeEvent, windowId: unknown): BrowserWindow => {
+    assertXaihiWindowSender(event)
+    if (typeof windowId !== 'number' || !Number.isInteger(windowId)) {
+      throw new Error('xaihi desktop: windowId must be an integer')
+    }
+    const window = xaihiWindowById(windowId)
+    if (window === undefined) throw new Error('xaihi desktop: unknown window')
+    return window
+  }
+  const boundsOf = (window: BrowserWindow) => {
+    const { x, y, width, height } = window.getBounds()
+    return { x, y, width, height }
+  }
+  ipcMain.handle(DESKTOP_IPC.xaihiWindowOpen, (event, node: unknown, input?: unknown) => {
+    const isMainDocument = assertXaihiWindowSender(event)
     if (input !== undefined && (input === null || typeof input !== 'object')) {
       throw new Error('xaihi desktop: options must be an object of documentPath, width, height')
     }
@@ -814,6 +848,36 @@ async function main(): Promise<void> {
     return { windowId: opening.window.id, alreadyOpen: opening.alreadyOpen }
   })
 
+  // Xaihi patch 0010: 基线 `WindowRuntime` 里"寻址已经开出去的那个窗"的四条
+  // （`Xiranite/src/backend/runtime/runtime.ts:139-143`）。四条都在同一张登记表里走，
+  // 且 `setBounds` 回读的是**生效之后**的矩形，不回收调用方给的那份 —— 屏幕会 clamp，
+  // 报回去的必须是界面实际拿到的那一个，否则界面就在一对自己撒谎。
+  ipcMain.handle(DESKTOP_IPC.xaihiWindowFocus, (event, windowId: unknown) => {
+    const window = needXaihiWindow(event, windowId)
+    if (window.isMinimized()) window.restore()
+    window.show()
+    window.focus()
+    return { windowId: window.id }
+  })
+  ipcMain.handle(DESKTOP_IPC.xaihiWindowClose, (event, windowId: unknown) => {
+    const window = needXaihiWindow(event, windowId)
+    const id = window.id
+    window.close()
+    return { windowId: id }
+  })
+  ipcMain.handle(DESKTOP_IPC.xaihiWindowGetBounds, (event, windowId: unknown) => {
+    return boundsOf(needXaihiWindow(event, windowId))
+  })
+  ipcMain.handle(DESKTOP_IPC.xaihiWindowSetBounds, (event, windowId: unknown, bounds: unknown) => {
+    const window = needXaihiWindow(event, windowId)
+    const next = normalizeXaihiWindowBounds(bounds)
+    if (next === undefined) {
+      throw new Error('xaihi desktop: bounds must be integer x, y with width and height within the allowed bounds')
+    }
+    window.setBounds(next)
+    return boundsOf(window)
+  })
+
   session.defaultSession.webRequest.onBeforeSendHeaders({ urls: ['ws://127.0.0.1/*'] }, (details, callback) => {
     if (hostUrl === undefined || hostCookie === undefined || details.webContentsId !== mainWindow?.webContents.id) {
       callback({})
