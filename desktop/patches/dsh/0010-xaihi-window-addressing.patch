 /** Desktop release update state rendered by desktop-owned UI. */
@@ -102,6 +106,19 @@ export interface DshDesktopProductApi {
       readonly width?: number
       readonly height?: number
     }): Promise<{ readonly windowId: number, readonly alreadyOpen: boolean }>
+    /**
+     * Xaihi patch 0010: address a window the caller already opened. The id must be one of Xaihi's
+     * own document windows — a caller that guesses the product window's id is refused with
+     * `unknown window`, because these verbs never reach outside the Xaihi window registry.
+     * `focus` / `close` mirror the baseline's `WindowRuntime.focus` / `.close`
+     * (`Xiranite/src/backend/runtime/runtime.ts:139-140`); `getBounds` / `setBounds` mirror
+     * `.getFrame` / `.setFrame` (`:142-143`) and read the applied bounds back rather than
+     * echoing the request, since a screen can clamp them.
+     */
+    focus(windowId: number): Promise<{ readonly windowId: number }>
+    close(windowId: number): Promise<{ readonly windowId: number }>
+    getBounds(windowId: number): Promise<{ readonly x: number, readonly y: number, readonly width: number, readonly height: number }>
+    setBounds(windowId: number, bounds: { x: number, y: number, width: number, height: number }): Promise<{ readonly x: number, readonly y: number, readonly width: number, readonly height: number }>
   }
   readonly updates: {
     status(): Promise<DesktopUpdatePresentation>
