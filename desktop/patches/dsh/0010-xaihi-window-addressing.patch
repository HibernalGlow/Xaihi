+      setBounds: (windowId: number, bounds: { x: number, y: number, width: number, height: number }) => ipcRenderer.invoke(DESKTOP_IPC.xaihiWindowSetBounds, windowId, bounds) as Promise<{ readonly x: number, readonly y: number, readonly width: number, readonly height: number }>,
     },
