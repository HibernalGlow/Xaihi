---
 apps/desktop/src/main.ts | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/main.ts b/apps/desktop/src/main.ts
index 298db1e..63e630d 100644
--- a/apps/desktop/src/main.ts
+++ b/apps/desktop/src/main.ts
@@ -536,6 +536,21 @@ async function main(): Promise<void> {
     navigation = next
     return next.promise
   }
+  const resolveTargetWorkspaceUrl = async (): Promise<string> => {
+    if (hostUrl !== undefined && hostCookie !== undefined) {
+      try {
+        const manifestTarget = new URL('/xaihi/manifest.json', hostUrl)
+        const manifestRes = await fetch(manifestTarget, { headers: { cookie: hostCookie } })
+        if (manifestRes.ok) {
+          const manifest = (await manifestRes.json()) as { ui?: { documentUrl?: string } }
+          if (typeof manifest?.ui?.documentUrl === 'string' && manifest.ui.documentUrl.startsWith('/xaihi/ui/')) {
+            return `${SCHEME}://app${manifest.ui.documentUrl}`
+          }
+        }
+      } catch {}
+    }
+    return applicationUrl
+  }
   const platformView = new DesktopPlatformView(join(app.getAppPath(), 'lib', 'preload-platform-account.cjs'),
     () => locale.id === 'zh-CN' ? 'zh_CN' : 'en_US', process.platform === 'win32' ? 'win32' : 'darwin')
   const backend = new DesktopBackendController((onFailure) => {
@@ -643,7 +658,7 @@ async function main(): Promise<void> {
           if (quitting) return
           // A replacement Host can have a new port, cookie, or boot injections even at the same URL.
           navigation = undefined
-          await navigateMain(applicationUrl)
+          await navigateMain(await resolveTargetWorkspaceUrl())
           if (backend.host !== undefined) updateJournal?.action('workspace-ready')
         })
         workspaceRecovery = recovery
@@ -1414,7 +1429,7 @@ async function main(): Promise<void> {
   const enterWorkspace = async ({ activate = true }: { activate?: boolean } = {}): Promise<void> => {
     if (quitting) return
     const window = mainWindow ?? createMainWindow()
-    await navigateMain(applicationUrl)
+    await navigateMain(await resolveTargetWorkspaceUrl())
     if (isQuitting() || recovery.active || window.isDestroyed()) return
     if (activate) window.show()
     else window.showInactive()
