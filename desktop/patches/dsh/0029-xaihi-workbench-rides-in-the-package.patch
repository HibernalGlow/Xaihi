diff --git a/apps/desktop/src/project-manager.ts b/apps/desktop/src/project-manager.ts
index 270d87d..9c7bb9a 100644
--- a/apps/desktop/src/project-manager.ts
+++ b/apps/desktop/src/project-manager.ts
@@ -173,4 +173,67 @@ export function createDevelopmentProjectMetadata(projectDir: string, release: De
 /** Create the first external plugin profile without running a package manager. */
 export function createPluginProfile(projectDir: string): void {
   initProfile(projectDir, WEB_PROFILE.bundles)
+  applyXaihiWorkbenchPayload(projectDir)
+}
+
+/** Workbench payload shipped beside the runtime: `Resources/xaihi` (see desktop/desktop-payload.mjs). */
+interface XaihiWorkbenchPayload {
+  readonly bundles: readonly string[]
+  readonly coreConfig: { readonly uiBundleDir: string, readonly verbose: boolean }
+}
+
+/**
+ * Locate the shipped workbench payload. `XAIHI_DESKTOP_PAYLOAD_DIR` names it during development; a packaged
+ * build ships it at `Resources/xaihi`, so an ordinary upstream runtime resolves nothing and keeps its profile.
+ * @returns Payload directory and its manifest, or undefined when this build ships no workbench.
+ */
+function readXaihiWorkbenchPayload(): { readonly dir: string, readonly payload: XaihiWorkbenchPayload } | undefined {
+  const resourcesPath = (process as { resourcesPath?: string }).resourcesPath
+  const configured = process.env.XAIHI_DESKTOP_PAYLOAD_DIR?.trim()
+  const dir = configured === undefined || configured === ''
+    ? (resourcesPath === undefined || resourcesPath === '' ? undefined : join(resourcesPath, 'xaihi'))
+    : configured
+  if (dir === undefined || !existsSync(join(dir, 'profile.json'))) return undefined
+  const payload = JSON.parse(readFileSync(join(dir, 'profile.json'), 'utf8')) as XaihiWorkbenchPayload
+  if (!Array.isArray(payload.bundles) || typeof payload.coreConfig?.uiBundleDir !== 'string') {
+    throw new Error(`desktop project: ${join(dir, 'profile.json')} is not a workbench payload`)
+  }
+  return { dir, payload }
+}
+
+/**
+ * Add the shipped workbench to a profile that was just created: our bundles as `file:` copies taken from the
+ * payload, and the `xaihi-core` patch row that points the workbench route at the shipped document directory.
+ * @param projectDir - Profile directory holding `package.json` and `cordis.patch.yml`.
+ */
+export function applyXaihiWorkbenchPayload(projectDir: string): void {
+  const shipped = readXaihiWorkbenchPayload()
+  if (shipped === undefined) return
+  const manifestPath = join(projectDir, 'package.json')
+  const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as {
+    dependencies?: Record<string, string>
+    dsh?: { profile?: { bundles?: string[] } }
+  }
+  const dependencies = { ...manifest.dependencies }
+  for (const name of shipped.payload.bundles) {
+    const pack = join(shipped.dir, 'packs', name.replace('@hibernalglow/', ''))
+    if (!existsSync(join(pack, 'lib', 'index.js'))) {
+      throw new Error(`desktop project: workbench payload pack ${pack} has no lib/index.js`)
+    }
+    dependencies[name] = `file:${pack}`
+  }
+  const bundles = [...new Set([...(manifest.dsh?.profile?.bundles ?? []), ...shipped.payload.bundles])]
+  writeFileSync(manifestPath, `${JSON.stringify({
+    ...manifest,
+    dependencies,
+    dsh: { ...(manifest.dsh ?? {}), profile: { ...(manifest.dsh?.profile ?? {}), bundles } },
+  }, null, 2)}\n`)
+
+  const patchPath = join(projectDir, 'cordis.patch.yml')
+  const current = existsSync(patchPath) ? readFileSync(patchPath, 'utf8') : ''
+  if (current.includes('uiBundleDir')) return
+  const row = '# Xaihi workbench: the shipped document directory must be explicit, otherwise the route answers 503.\n'
+    + `- id: xaihi-core\n  config:\n    verbose: ${String(shipped.payload.coreConfig.verbose)}\n`
+    + `    uiBundleDir: ${JSON.stringify(join(shipped.dir, 'ui'))}\n`
+  writeFileSync(patchPath, current.trimEnd().length === 0 ? row : `${current.trimEnd()}\n\n${row}`)
 }
