diff --git a/apps/desktop/tests/xaihi-workbench-payload.spec.ts b/apps/desktop/tests/xaihi-workbench-payload.spec.ts
new file mode 100644
index 0000000..923f4a2
--- /dev/null
+++ b/apps/desktop/tests/xaihi-workbench-payload.spec.ts
@@ -0,0 +1,78 @@
+// 载荷的对照：装了它，新建的 profile 就带上我们的 bundle 与 uiBundleDir；没装，profile 与上游逐字相同。
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createPluginProfile } from '../src/project-manager.ts'
+
+const BUNDLES = ['@hibernalglow/xaihi-core', '@hibernalglow/xaihi-ui']
+
+/** 造一份最小载荷：profile.json + 每个 bundle 的 lib/index.js + 工作台产物目录。 */
+function writePayload (bundles: readonly string[] = BUNDLES): string {
+  const dir = mkdtempSync(join(tmpdir(), 'xaihi-payload-'))
+  mkdirSync(join(dir, 'ui'), { recursive: true })
+  writeFileSync(join(dir, 'ui', 'main.js'), 'export {}\n')
+  for (const name of bundles) {
+    mkdirSync(join(dir, 'packs', name.replace('@hibernalglow/', ''), 'lib'), { recursive: true })
+    writeFileSync(join(dir, 'packs', name.replace('@hibernalglow/', ''), 'lib', 'index.js'), 'export {}\n')
+  }
+  writeFileSync(join(dir, 'profile.json'), `${JSON.stringify({
+    schemaVersion: 1, bundles, coreConfig: { uiBundleDir: 'ui', verbose: false },
+  }, null, 2)}\n`)
+  return dir
+}
+
+function freshProfile (): string {
+  const dir = mkdtempSync(join(tmpdir(), 'dsh-profile-'))
+  return dir
+}
+
+describe('Xaihi workbench payload', () => {
+  afterEach(() => { vi.unstubAllEnvs() })
+
+  it('installs the shipped workbench into a freshly created profile', () => {
+    const payload = writePayload()
+    vi.stubEnv('XAIHI_DESKTOP_PAYLOAD_DIR', payload)
+    const profile = freshProfile()
+    createPluginProfile(profile)
+
+    const manifest = JSON.parse(readFileSync(join(profile, 'package.json'), 'utf8')) as {
+      dependencies: Record<string, string>
+      dsh: { profile: { bundles: string[] } }
+    }
+    expect(manifest.dependencies['@hibernalglow/xaihi-core']).toBe(`file:${join(payload, 'packs', 'xaihi-core')}`)
+    expect(manifest.dependencies['@hibernalglow/xaihi-ui']).toBe(`file:${join(payload, 'packs', 'xaihi-ui')}`)
+    expect(manifest.dsh.profile.bundles).toContain('@hibernalglow/xaihi-core')
+    expect(manifest.dsh.profile.bundles).toContain('@hibernalglow/xaihi-ui')
+
+    const patch = readFileSync(join(profile, 'cordis.patch.yml'), 'utf8')
+    expect(patch).toContain('id: xaihi-core')
+    expect(patch).toContain(`uiBundleDir: ${JSON.stringify(join(payload, 'ui'))}`)
+  })
+
+  it('refuses a payload whose pack has no built entry instead of writing a broken profile', () => {
+    const payload = writePayload(['@hibernalglow/xaihi-core'])
+    const manifestPath = join(payload, 'profile.json')
+    const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as { bundles: string[] }
+    writeFileSync(manifestPath, `${JSON.stringify({ ...manifest, bundles: [...manifest.bundles, '@hibernalglow/xaihi-ui'] }, null, 2)}\n`)
+    vi.stubEnv('XAIHI_DESKTOP_PAYLOAD_DIR', payload)
+    expect(() => { createPluginProfile(freshProfile()) }).toThrow(/has no lib\/index\.js/u)
+  })
+
+  it('leaves the profile exactly as upstream builds it when no payload is shipped', () => {
+    vi.stubEnv('XAIHI_DESKTOP_PAYLOAD_DIR', '')
+    const profile = freshProfile()
+    createPluginProfile(profile)
+
+    const manifest = JSON.parse(readFileSync(join(profile, 'package.json'), 'utf8')) as {
+      dependencies?: Record<string, string>
+      dsh: { profile: { bundles: string[] } }
+    }
+    expect(Object.keys(manifest.dependencies ?? {})).not.toContain('@hibernalglow/xaihi-core')
+    expect(manifest.dsh.profile.bundles).not.toContain('@hibernalglow/xaihi-core')
+    // `initProfile` seeds its own patch file; we add nothing to it when no payload ships.
+    const patch = existsSync(join(profile, 'cordis.patch.yml')) ? readFileSync(join(profile, 'cordis.patch.yml'), 'utf8') : ''
+    expect(patch).not.toContain('uiBundleDir')
+    expect(patch).not.toContain('xaihi-core')
+  })
+})
