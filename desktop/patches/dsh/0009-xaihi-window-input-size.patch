+function openXaihiDocumentWindow (preload: string, target: string, size?: XaihiWindowSize): XaihiWindowOpening {
   const key = xaihiWindowKey(target)
   const existing = xaihiDocumentWindows.get(key)
   if (existing !== undefined && !existing.isDestroyed()) {
@@ -236,6 +240,7 @@ function openXaihiDocumentWindow (preload: string, target: string): XaihiWindowO
     return { window: existing, alreadyOpen: true }
   }
   const window = createWindow(preload, true, false)
+  if (size !== undefined) window.setSize(size.width, size.height)
   // 标题是使用者辨认"这个窗是哪个 node"的唯一读回面；文档自己带 <title>，
