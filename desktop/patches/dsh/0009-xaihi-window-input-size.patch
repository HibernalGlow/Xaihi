--- a/apps/desktop/src/ipc.ts
+++ b/apps/desktop/src/ipc.ts
@@ -88,11 +88,20 @@ export interface DshDesktopProductApi {
    * the product document that hosts it may pass the document path explicitly. The shell then
    * validates that path against its own `/xaihi/ui/<rev>/index.html` route shape instead of
    * trusting any URL the caller is sitting on; scheme and host stay the shell's.
+   * Xaihi patch 0009 folds both into one input object and adds the optional opening size,
+   * shaped like the baseline's `OpenComponentWindowInput` (`width` / `height`). The caller owns
+   * that memory (Xaihi persists it through DSH's settings surface, per ADR-0013); the shell only
+   * validates it and applies it to a *newly created* window — a repeat request focuses the live
+   * window instead of resizing what the user already positioned.
    * Consumers must feature-detect this member: stock Desktop and `dsh web` do not provide it,
    * and Xaihi degrades visibly there.
    */
   readonly xaihiWindow?: {
-    open(node: string, documentPath?: string): Promise<{ readonly windowId: number, readonly alreadyOpen: boolean }>
+    open(node: string, options?: {
+      readonly documentPath?: string
+      readonly width?: number
+      readonly height?: number
+    }): Promise<{ readonly windowId: number, readonly alreadyOpen: boolean }>
   }
   readonly updates: {
     status(): Promise<DesktopUpdatePresentation>
