diff --git a/apps/desktop/src/xaihi-window-policy.ts b/apps/desktop/src/xaihi-window-policy.ts
index 0af05dc..b6845cd 100644
--- a/apps/desktop/src/xaihi-window-policy.ts
+++ b/apps/desktop/src/xaihi-window-policy.ts
@@ -86,3 +86,33 @@ export function xaihiWindowKey (url: string): string {
   }
   return parsed.searchParams.get('node') ?? 'workspace'
 }
+
+/**
+ * Xaihi patch 0009: the remembered size a caller may ask a node window to open at.
+ *
+ * 形状照基线的 `OpenComponentWindowInput`（`Xiranite/src/backend/runtime/runtime.ts:125-132`：
+ * `componentId` 加可选 `width` / `height`）—— 尺寸**由调用方带**，因为"哪个节点窗多大"属于
+ * Xaihi 自己的耐久数据（ADR-0013：走 DSH 的 storage/settings 面），壳不另开一份存储。
+ * 这里只做纯校验：有限整数、且在 `createWindow` 的最小尺寸与一个上限之间；不合就整个请求按
+ * 形状错误拒掉，不许"看着不像就 silently 用缺省尺寸"——那会把调用方的错误吞成一次成功的开窗。
+ */
+export interface XaihiWindowSize {
+  readonly width: number
+  readonly height: number
+}
+
+// 下界与 `createWindow` 的 `minWidth` / `minHeight` 同档（`main.ts` 里那两个数）：
+// 允许调用方要一个壳自己不许的尺寸，等于让 Electron 悄悄 clamp 之后再也没人知道。
+const MIN_WINDOW_WIDTH = 520
+const MIN_WINDOW_HEIGHT = 600
+const MAX_WINDOW_SIZE = 12000
+
+export function normalizeXaihiWindowSize (size: unknown): XaihiWindowSize | undefined {
+  if (size === null || typeof size !== 'object') return undefined
+  const { width, height } = size as { width?: unknown, height?: unknown }
+  if (typeof width !== 'number' || typeof height !== 'number') return undefined
+  if (!Number.isInteger(width) || !Number.isInteger(height)) return undefined
+  if (width < MIN_WINDOW_WIDTH || height < MIN_WINDOW_HEIGHT) return undefined
+  if (width > MAX_WINDOW_SIZE || height > MAX_WINDOW_SIZE) return undefined
+  return { width, height }
+}
