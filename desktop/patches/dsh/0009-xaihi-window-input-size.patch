   window.on('page-title-updated', (event) => { event.preventDefault() })
@@ -762,9 +767,13 @@ async function main(): Promise<void> {
   // Xaihi patch 0007: 被嵌在产品文档里的 Xaihi 帧自己没有 preload（子帧拿不到动词），
   // 所以那一层的请求由产品文档转达，并显式带文档路径 —— 这条分支改判**发起者的 URL**为
   // **显式路径必须自己通过同一条路由形状校验**；scheme 与 host 仍然只有壳自己那一份。
+  // Xaihi patch 0009: 第二个参数收成**一个 input 对象**（`documentPath` / `width` / `height`），
+  // 形状照基线的 `OpenComponentWindowInput`（`Xiranite/src/backend/runtime/runtime.ts:125-132`）。
+  // 尺寸由调用方带 —— "哪个节点窗多大"是 Xaihi 自己的耐久数据（ADR-0013 走 DSH 的 settings/storage 面），
+  // 壳不另开一份存储；这里只做纯校验，半套尺寸（只有 width 或只有 height）按形状错误拒。
   const XAIHI_NODE_PATTERN = /^[a-z0-9][a-z0-9_-]{0,63}$/u
   const XAIHI_DOCUMENT_PATH = /^\/xaihi\/ui\/[0-9a-f]{12}\/index\.html$/u
-  ipcMain.handle(DESKTOP_IPC.xaihiWindowOpen, (event, node: unknown, documentPath?: unknown) => {
+  ipcMain.handle(DESKTOP_IPC.xaihiWindowOpen, (event, node: unknown, input?: unknown) => {
     assertDesktopSender(event, ['app'])
     const frame = event.senderFrame
     if (frame === null || frame !== event.sender.mainFrame) {
@@ -774,6 +783,10 @@ async function main(): Promise<void> {
     if (!isMainDocument && !xaihiOwnedSender(event.sender)) {
       throw new Error('xaihi desktop: rejected window request from an unowned renderer')
     }
+    if (input !== undefined && (input === null || typeof input !== 'object')) {
+      throw new Error('xaihi desktop: options must be an object of documentPath, width, height')
+    }
+    const { documentPath, width, height } = (input ?? {}) as { documentPath?: unknown, width?: unknown, height?: unknown }
     if (typeof node !== 'string' || !XAIHI_NODE_PATTERN.test(node)) {
       throw new Error('xaihi desktop: node must match [a-z0-9][a-z0-9_-]{0,63}')
     }
@@ -789,8 +802,15 @@ async function main(): Promise<void> {
         throw new Error('xaihi desktop: only the Xaihi UI document may open a window')
       }
     }
+    let size: XaihiWindowSize | undefined
+    if (width !== undefined || height !== undefined) {
+      size = normalizeXaihiWindowSize({ width, height })
+      if (size === undefined) {
+        throw new Error('xaihi desktop: width and height must both be integers within the allowed bounds')
+      }
+    }
     url.searchParams.set('node', node)
-    const opening = openXaihiDocumentWindow(appPreload, url.toString())
+    const opening = openXaihiDocumentWindow(appPreload, url.toString(), size)
     return { windowId: opening.window.id, alreadyOpen: opening.alreadyOpen }
   })
 
