@@ -117,6 +117,45 @@ export function normalizeXaihiWindowSize (size: unknown): XaihiWindowSize | unde
   return { width, height }
 }
 
+/**
+ * Xaihi patch 0011: 能力协商的形状，逐字段照基线
+ * `Xiranite/src/backend/runtime/runtime.ts:86-99` 的 `WindowCapabilities`。
+ *
+ * 为什么这条不是"锦上添花"：基线那份注释写得很直白 —— `captionOwner: 'system'` 意味着
+ * **应用不许在红绿灯上再画一套按钮**（`frameless` 与 `captionInset` 同理是给 `TopBar` /
+ * `FloatingWindowFrame` 决定画不画东西用的）。界面若自己猜这些位，猜错就是一个可见缺陷：
+ * 两套窗控，或者窗控根本没画出来。所以值必须由**构造窗口的那份 options** 推出来，
+ * 而不是在 IPC 那侧写死四个常量（见 `main.ts` 的 `xaihiWindowCapabilities`）。
+ */
+export interface XaihiWindowCapabilities {
+  readonly supported: true
+  readonly nativeWindowControls: boolean
+  readonly frameless: boolean
+  readonly captionOwner: 'system' | 'renderer'
+  /** 只有 `captionOwner` 是 `system` 时才有；来源是 `trafficLightPosition`，不另猜一份数。 */
+  readonly captionInset?: { readonly x: number, readonly y: number }
+  readonly componentWindows: 'native' | 'browser-fallback' | 'browser-popup' | 'unsupported'
+  readonly message: string
+}
+
+/** 一个 Xaihi 文档窗能做什么：0010 那四条寻址动词都在这张表里的窗上可用。 */
+export function xaihiWindowCapabilities (
+  frame: 'inset' | 'overlay' | 'native',
+  captionInset?: { x: number, y: number },
+  addressingVerbs = 0,
+): XaihiWindowCapabilities {
+  return {
+    supported: true,
+    nativeWindowControls: true,
+    frameless: false,
+    // 'overlay' 才是渲染方自己画按钮（Windows 的 titleBarOverlay 就是这个用途）；
+    // mac 的 hiddenInset 与原生框都由系统画 ⇒ 'system'，界面这时**不许**再画一套。
+    captionOwner: frame === 'overlay' ? 'renderer' : 'system',
+    ...(frame === 'inset' && captionInset !== undefined ? { captionInset } : {}),
+    componentWindows: 'native',
+    message: `Xaihi desktop shell: native component windows; ${String(addressingVerbs)} verbs address one window by id`,
+  }
+}
 /** 一条窗的位置与尺寸；`x`/`y` 是屏幕坐标，可以带符号。 */
 export interface XaihiWindowBounds extends XaihiWindowSize {
   readonly x: number
