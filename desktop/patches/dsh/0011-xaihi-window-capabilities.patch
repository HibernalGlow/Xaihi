+const DARWIN_TRAFFIC_LIGHT_POSITION = { x: 16, y: 18 }
+
 function createWindow(preload: string, show = false, primary = false): BrowserWindow {
   const window = new BrowserWindow({
     width: 1280,
@@ -280,7 +287,7 @@ function createWindow(preload: string, show = false, primary = false): BrowserWi
     // needs a transparent window background to show through the page.
     ...(process.platform === 'darwin' ? {
       titleBarStyle: 'hiddenInset' as const,
-      trafficLightPosition: { x: 16, y: 18 },
+      trafficLightPosition: DARWIN_TRAFFIC_LIGHT_POSITION,
       vibrancy: 'sidebar' as const,
       // 'active' keeps the vibrancy material stable when the window blurs;
       // 'followWindow' washes the sidebar out behind an unfocused window.
@@ -297,6 +304,17 @@ function createWindow(preload: string, show = false, primary = false): BrowserWi
       devTools: true,
     },
   })
+  // Xaihi patch 0011: 这份窗的标题栏形状就地记一份，给能力协商用。
+  // 三条分支与上面 options 里那三个 `titleBarStyle` 一一对应（mac hiddenInset /
+  // Windows 主窗 hidden + titleBarOverlay / 其余原生框）。这里**不假装从窗上读回来**：
+  // Electron 44 的 BrowserWindow 只有 `setTitleBarOverlay`，没有 `getTitleBarOverlay`
+  // 也没有 `getTrafficLightPosition`（现读 `electron.d.ts`），所以形状由构造决定、就地记。
+  const captionKind: 'inset' | 'overlay' | 'native' = process.platform === 'darwin'
+    ? 'inset'
+    : process.platform === 'win32' && primary
+      ? 'overlay'
+      : 'native'
+  xaihiCaptionKinds.set(window, captionKind)
   window.webContents.setWindowOpenHandler(({ url }) => {
     // Xaihi patch 0002: 页面递来的 URL 先过纯判策；不是自家文档就维持原样（外链交系统浏览器，其余 deny）。
     const target = resolveXaihiDocumentTarget({ url, openerUrl: window.webContents.getURL() })
@@ -852,6 +870,19 @@ async function main(): Promise<void> {
   // （`Xiranite/src/backend/runtime/runtime.ts:139-143`）。四条都在同一张登记表里走，
   // 且 `setBounds` 回读的是**生效之后**的矩形，不回收调用方给的那份 —— 屏幕会 clamp，
   // 报回去的必须是界面实际拿到的那一个，否则界面就在一对自己撒谎。
+  // Xaihi patch 0011: 协商。形状逐字段照基线的 `WindowCapabilities`
+  // （`Xiranite/src/backend/runtime/runtime.ts:86-99`），因为界面拿它决定**画不画自己那套窗控** ——
+  // 猜错的表现为两套按钮压在红绿灯上，或干脆没有按钮，都是看得见的错。
+  ipcMain.handle(DESKTOP_IPC.xaihiWindowCapabilities, (event) => {
+    assertXaihiWindowSender(event)
+    const kind = mainWindow === undefined ? 'native' : xaihiCaptionKinds.get(mainWindow) ?? 'native'
+    return xaihiWindowCapabilities(
+      kind,
+      kind === 'inset' ? DARWIN_TRAFFIC_LIGHT_POSITION : undefined,
+      // 条数从真那张通道表推（改天补一条动词，这里跟着变），不写死一个会漂移的数。
+      Object.keys(DESKTOP_IPC).filter((name) => name.startsWith('xaihiWindow') && name !== 'xaihiWindowCapabilities' && name !== 'xaihiWindowOpen').length,
+    )
+  })
   ipcMain.handle(DESKTOP_IPC.xaihiWindowFocus, (event, windowId: unknown) => {
     const window = needXaihiWindow(event, windowId)
     if (window.isMinimized()) window.restore()
