   windowsAppearance: 'dsh-desktop:windows-appearance',
   windowsMenu: 'dsh-desktop:windows-menu',
   xaihiWindowOpen: 'dsh-desktop:xaihi-window-open',
+  xaihiWindowCapabilities: 'dsh-desktop:xaihi-window-capabilities',
   xaihiWindowFocus: 'dsh-desktop:xaihi-window-focus',
   xaihiWindowClose: 'dsh-desktop:xaihi-window-close',
   xaihiWindowGetBounds: 'dsh-desktop:xaihi-window-get-bounds',
@@ -115,6 +117,12 @@ export interface DshDesktopProductApi {
      * `.getFrame` / `.setFrame` (`:142-143`) and read the applied bounds back rather than
      * echoing the request, since a screen can clamp them.
      */
+    /**
+     * Xaihi patch 0011: 协商。字段逐字照基线的 `WindowCapabilities`
+     * （`Xiranite/src/backend/runtime/runtime.ts:86-99`）—— 界面用它决定**要不要画自己那套窗控**，
+     * 所以值由构造窗口时那份 `titleBarStyle` 推出来，不是两边各猜一次。
+     */
+    getCapabilities(): Promise<XaihiWindowCapabilities>
     focus(windowId: number): Promise<{ readonly windowId: number }>
     close(windowId: number): Promise<{ readonly windowId: number }>
     getBounds(windowId: number): Promise<{ readonly x: number, readonly y: number, readonly width: number, readonly height: number }>
