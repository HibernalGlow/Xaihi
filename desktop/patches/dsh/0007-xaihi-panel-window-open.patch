---
 apps/desktop/src/ipc.ts         | 13 +++++++++----
 apps/desktop/src/main.ts        | 25 ++++++++++++++++++-------
 apps/desktop/src/preload-app.ts |  2 +-
 3 files changed, 28 insertions(+), 12 deletions(-)

diff --git a/apps/desktop/src/ipc.ts b/apps/desktop/src/ipc.ts
index 871b522..b36837b 100644
--- a/apps/desktop/src/ipc.ts
+++ b/apps/desktop/src/ipc.ts
@@ -82,12 +82,17 @@ export interface DshDesktopProductApi {
   deviceInfo(): Promise<string>
   /**
    * Xaihi patch (ADR-0011 决定 3): open one more native window for Xaihi's own document.
-   * The caller names only a node id — the shell rewrites its own primary document URL, so no
-   * caller-supplied path or origin ever reaches `loadURL`. Consumers must feature-detect this
-   * member: stock Desktop and `dsh web` do not provide it, and Xaihi degrades visibly there.
+   * Without `documentPath` the caller must itself be that document — the shell rewrites the
+   * caller's own URL, so no caller-supplied path or origin ever reaches `loadURL`.
+   * Xaihi patch 0007 adds the panel case: an embedded Xaihi frame has no preload of its own, so
+   * the product document that hosts it may pass the document path explicitly. The shell then
+   * validates that path against its own `/xaihi/ui/<rev>/index.html` route shape instead of
+   * trusting any URL the caller is sitting on; scheme and host stay the shell's.
+   * Consumers must feature-detect this member: stock Desktop and `dsh web` do not provide it,
+   * and Xaihi degrades visibly there.
    */
   readonly xaihiWindow?: {
-    open(node: string): Promise<{ readonly windowId: number, readonly alreadyOpen: boolean }>
+    open(node: string, documentPath?: string): Promise<{ readonly windowId: number, readonly alreadyOpen: boolean }>
   }
   readonly updates: {
     status(): Promise<DesktopUpdatePresentation>
diff --git a/apps/desktop/src/main.ts b/apps/desktop/src/main.ts
index 88806f6..8cfbd41 100644
--- a/apps/desktop/src/main.ts
+++ b/apps/desktop/src/main.ts
@@ -759,25 +759,36 @@ async function main(): Promise<void> {
   // Xaihi patch (ADR-0011 决定 3): 节点各自成窗 = 同一份 Xaihi 文档 + 只换 `node` 查询段。
   // 发起者可以是主窗或任一活着的 Xaihi 文档窗，目标地址取自发起者自己的 URL：
   // 主窗关闭只是隐藏，此时只有节点窗还在前台。scheme、hostname、rev 与主帧四项守卫照旧全收。
+  // Xaihi patch 0007: 被嵌在产品文档里的 Xaihi 帧自己没有 preload（子帧拿不到动词），
+  // 所以那一层的请求由产品文档转达，并显式带文档路径 —— 这条分支改判**发起者的 URL**为
+  // **显式路径必须自己通过同一条路由形状校验**；scheme 与 host 仍然只有壳自己那一份。
   const XAIHI_NODE_PATTERN = /^[a-z0-9][a-z0-9_-]{0,63}$/u
   const XAIHI_DOCUMENT_PATH = /^\/xaihi\/ui\/[0-9a-f]{12}\/index\.html$/u
-  ipcMain.handle(DESKTOP_IPC.xaihiWindowOpen, (event, node: unknown) => {
+  ipcMain.handle(DESKTOP_IPC.xaihiWindowOpen, (event, node: unknown, documentPath?: unknown) => {
     assertDesktopSender(event, ['app'])
     const frame = event.senderFrame
     if (frame === null || frame !== event.sender.mainFrame) {
       throw new Error('xaihi desktop: rejected window request from a non-primary frame')
     }
-    const owned = mainWindow !== undefined && !mainWindow.isDestroyed() && mainWindow.webContents === event.sender
-    if (!owned && !xaihiOwnedSender(event.sender)) {
+    const isMainDocument = mainWindow !== undefined && !mainWindow.isDestroyed() && mainWindow.webContents === event.sender
+    if (!isMainDocument && !xaihiOwnedSender(event.sender)) {
       throw new Error('xaihi desktop: rejected window request from an unowned renderer')
     }
-    const url = new URL(event.sender.getURL())
-    if (url.protocol !== `${SCHEME}:` || url.hostname !== 'app' || !XAIHI_DOCUMENT_PATH.test(url.pathname)) {
-      throw new Error('xaihi desktop: only the Xaihi UI document may open a window')
-    }
     if (typeof node !== 'string' || !XAIHI_NODE_PATTERN.test(node)) {
       throw new Error('xaihi desktop: node must match [a-z0-9][a-z0-9_-]{0,63}')
     }
+    let url: URL
+    if (isMainDocument && documentPath !== undefined) {
+      if (typeof documentPath !== 'string' || !XAIHI_DOCUMENT_PATH.test(documentPath)) {
+        throw new Error('xaihi desktop: document path must match /xaihi/ui/<rev>/index.html')
+      }
+      url = new URL(`${SCHEME}://app${documentPath}`)
+    } else {
+      url = new URL(event.sender.getURL())
+      if (url.protocol !== `${SCHEME}:` || url.hostname !== 'app' || !XAIHI_DOCUMENT_PATH.test(url.pathname)) {
+        throw new Error('xaihi desktop: only the Xaihi UI document may open a window')
+      }
+    }
     url.searchParams.set('node', node)
     const opening = openXaihiDocumentWindow(appPreload, url.toString())
     return { windowId: opening.window.id, alreadyOpen: opening.alreadyOpen }
diff --git a/apps/desktop/src/preload-app.ts b/apps/desktop/src/preload-app.ts
index 0741bca..37c4d0d 100644
--- a/apps/desktop/src/preload-app.ts
+++ b/apps/desktop/src/preload-app.ts
@@ -17,7 +17,7 @@ function createProductApi(): DshDesktopProductApi {
     deviceInfo: () => ipcRenderer.invoke(DESKTOP_IPC.deviceInfo) as Promise<string>,
     // Xaihi patch: 只在主文档上给，且失败由主进程按同一套守卫判（ADR-0011 决定 4 要求消费端探测式使用）。
     xaihiWindow: {
-      open: (node: string) => ipcRenderer.invoke(DESKTOP_IPC.xaihiWindowOpen, node) as Promise<{ readonly windowId: number, readonly alreadyOpen: boolean }>,
+      open: (node: string, documentPath?: string) => ipcRenderer.invoke(DESKTOP_IPC.xaihiWindowOpen, node, documentPath) as Promise<{ readonly windowId: number, readonly alreadyOpen: boolean }>,
     },
     keyboard: {
       closeWindow: revision => ipcRenderer.invoke(DESKTOP_IPC.shortcutsCloseWindow, revision) as Promise<void>,
-- 
