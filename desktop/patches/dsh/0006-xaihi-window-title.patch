diff --git a/apps/desktop/src/main.ts b/apps/desktop/src/main.ts
index d0f8abc..88806f6 100644
--- a/apps/desktop/src/main.ts
+++ b/apps/desktop/src/main.ts
@@ -236,6 +236,9 @@ function openXaihiDocumentWindow (preload: string, target: string): XaihiWindowO
     return { window: existing, alreadyOpen: true }
   }
   const window = createWindow(preload, true, false)
+  // 标题是使用者辨认"这个窗是哪个 node"的唯一读回面；文档自己带 <title>，
+  // 不拦住 page-title-updated 就会把它覆盖成通用标题（实测读回只剩 "Xaihi"）。
+  window.on('page-title-updated', (event) => { event.preventDefault() })
   window.setTitle(`Xaihi \u00b7 ${key}`)
   xaihiDocumentWindows.set(key, window)
   window.on('closed', () => { if (xaihiDocumentWindows.get(key) === window) xaihiDocumentWindows.delete(key) })
