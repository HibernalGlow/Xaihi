diff --git a/apps/desktop/src/xaihi-startup-policy.ts b/apps/desktop/src/xaihi-startup-policy.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/xaihi-startup-policy.ts
@@ -0,0 +1,10 @@
+/** Xaihi 产品入口：仅接受 core 提供的完整、无查询参数的本地文档路径。 */
+import { resolveXaihiDocumentTarget } from './xaihi-window-policy.ts'
+
+export function xaihiPrimaryDocument(manifest: unknown): string | undefined {
+  if (manifest === null || typeof manifest !== 'object' || !('ui' in manifest)) return undefined
+  const ui = manifest.ui
+  if (ui === null || typeof ui !== 'object' || !('documentUrl' in ui) || typeof ui.documentUrl !== 'string') return undefined
+  if (!/^\/xaihi\/ui\/[0-9a-f]{12}\/index\.html$/u.test(ui.documentUrl)) return undefined
+  return resolveXaihiDocumentTarget({ url: `dsh-app://app${ui.documentUrl}`, openerUrl: 'dsh-app://app/' })
+}
