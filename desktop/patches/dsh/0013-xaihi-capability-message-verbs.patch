 apps/desktop/src/main.ts                | 2 --
 apps/desktop/src/xaihi-window-policy.ts | 3 +--
 2 files changed, 1 insertion(+), 4 deletions(-)

diff --git a/apps/desktop/src/main.ts b/apps/desktop/src/main.ts
index 3716015..b3cfa5b 100644
--- a/apps/desktop/src/main.ts
+++ b/apps/desktop/src/main.ts
@@ -893,8 +893,6 @@ async function main(): Promise<void> {
     return xaihiWindowCapabilities(
       kind,
       kind === 'inset' ? DARWIN_TRAFFIC_LIGHT_POSITION : undefined,
-      // 条数从真那张通道表推（改天补一条动词，这里跟着变），不写死一个会漂移的数。
-      Object.keys(DESKTOP_IPC).filter((name) => name.startsWith('xaihiWindow') && name !== 'xaihiWindowCapabilities' && name !== 'xaihiWindowOpen').length,
     )
   })
   ipcMain.handle(DESKTOP_IPC.xaihiWindowFocus, (event, windowId: unknown) => {
diff --git a/apps/desktop/src/xaihi-window-policy.ts b/apps/desktop/src/xaihi-window-policy.ts
index 2200022..8f6fcbd 100644
--- a/apps/desktop/src/xaihi-window-policy.ts
+++ b/apps/desktop/src/xaihi-window-policy.ts
@@ -142,7 +142,6 @@ export interface XaihiWindowCapabilities {
 export function xaihiWindowCapabilities (
   frame: 'inset' | 'overlay' | 'native',
   captionInset?: { x: number, y: number },
-  addressingVerbs = 0,
 ): XaihiWindowCapabilities {
   return {
     supported: true,
@@ -153,7 +152,7 @@ export function xaihiWindowCapabilities (
     captionOwner: frame === 'overlay' ? 'renderer' : 'system',
     ...(frame === 'inset' && captionInset !== undefined ? { captionInset } : {}),
     componentWindows: 'native',
-    message: `Xaihi desktop shell: native component windows; ${String(addressingVerbs)} verbs address one window by id`,
+    message: 'Xaihi desktop shell: native component windows; address by windowId: focus, close, getBounds, setBounds',
   }
 }
 /** 一条窗的位置与尺寸；`x`/`y` 是屏幕坐标，可以带符号。 */
