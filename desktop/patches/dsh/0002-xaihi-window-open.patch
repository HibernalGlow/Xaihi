+// Xaihi patch 0002: 由 window.open 转出来的原生窗。只做生命周期登记，不参与主窗的 hide-on-close。
+const xaihiDocumentWindows = new Set<BrowserWindow>()
+
+/** Open one secondary window for a URL the policy already accepted as Xaihi's own document. */
+function openXaihiDocumentWindow (preload: string, target: string): BrowserWindow {
+  const window = createWindow(preload, true, false)
+  xaihiDocumentWindows.add(window)
+  window.on('closed', () => { xaihiDocumentWindows.delete(window) })
+  void window.loadURL(target)
+  return window
+}
+
 function createWindow(preload: string, show = false, primary = false): BrowserWindow {
   const window = new BrowserWindow({
     width: 1280,
@@ -237,6 +250,12 @@ function createWindow(preload: string, show = false, primary = false): BrowserWi
     },
   })
   window.webContents.setWindowOpenHandler(({ url }) => {
+    // Xaihi patch 0002: 页面递来的 URL 先过纯判策；不是自家文档就维持原样（外链交系统浏览器，其余 deny）。
+    const target = resolveXaihiDocumentTarget({ url, openerUrl: window.webContents.getURL() })
+    if (target !== undefined) {
+      openXaihiDocumentWindow(preload, target)
+      return { action: 'deny' }
+    }
     if (['http:', 'https:'].includes(new URL(url).protocol)) void shell.openExternal(url)
