index 0000000..3c71031
--- /dev/null
+++ b/apps/desktop/src/xaihi-window-policy.ts
@@ -0,0 +1,52 @@
+/** Xaihi patch 0002: pure URL policy for turning a window.open request into a native Xaihi window. */
+
+/**
+ * Xaihi 文档的唯一落点。`<rev>` 必须是 core 那侧 `computeRev` 的 12 位十六进制
+ * （Xaihi 仓 `packages/core/src/routes.ts` 的 `REV_PATTERN`），所以这里按同一条形状收：
+ * 不接受调用方递上来的任意路径，就不需要再防目录穿越或跨 origin。
+ */
+const DOCUMENT_PATH = /^\/xaihi\/ui\/[0-9a-f]{12}\/index\.html$/u
+const NODE_VALUE = /^[a-z0-9][a-z0-9_-]{0,63}$/u
+const MAX_URL_LENGTH = 2048
+
+/** 一次开窗请求：目标是页面要打开的 URL，发起者是当前这份文档自己的 URL。 */
+export interface XaihiWindowRequest {
+  readonly url: string
+  readonly openerUrl: string
+}
+
+function parseOwnDocument(value: string): URL | undefined {
+  if (value.length === 0 || value.length > MAX_URL_LENGTH) return undefined
+  let url: URL
+  try {
+    url = new URL(value)
+  } catch {
+    return undefined
+  }
+  if (url.protocol !== 'dsh-app:' || url.hostname !== 'app') return undefined
+  if (!DOCUMENT_PATH.test(url.pathname)) return undefined
+  return url
+}
+
+/**
+ * 只允许"Xaihi 文档开 Xaihi 文档"，且查询串里只收 `node` 这一个键。
+ * @param request - the target URL plus the requesting document's own URL.
+ * @returns the normalized absolute URL to load, or `undefined` when the caller must deny.
+ */
+export function resolveXaihiDocumentTarget (request: XaihiWindowRequest): string | undefined {
+  const target = parseOwnDocument(request.url)
+  if (target === undefined) return undefined
+  // 发起者也必须是同一份 Xaihi 文档：DSH 自己的界面或别处递来的请求都走原来的 deny 分支。
+  const opener = parseOwnDocument(request.openerUrl)
+  if (opener === undefined) return undefined
+  for (const key of target.searchParams.keys()) {
+    if (key !== 'node') return undefined
+  }
+  const node = target.searchParams.get('node')
+  if (node !== null && !nodeValueAccepted(node)) return undefined
+  return target.toString()
+}
+
+function nodeValueAccepted (node: string): boolean {
+  return NODE_VALUE.test(node)
+}
