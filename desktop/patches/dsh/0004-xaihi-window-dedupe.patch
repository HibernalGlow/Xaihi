-// Xaihi patch 0002: 由 window.open 转出来的原生窗。只做生命周期登记，不参与主窗的 hide-on-close。
-const xaihiDocumentWindows = new Set<BrowserWindow>()
+// Xaihi patch 0002/0004: 由 window.open 或 IPC 动词转出来的原生窗，按它寻址的 node 去重。
+// 不参与主窗的 hide-on-close；重复请求聚焦既有的那一个，而不是叠第二个窗。
+const xaihiDocumentWindows = new Map<string, BrowserWindow>()
 
-/** Open one secondary window for a URL the policy already accepted as Xaihi's own document. */
-function openXaihiDocumentWindow (preload: string, target: string): BrowserWindow {
+export interface XaihiWindowOpening {
+  readonly window: BrowserWindow
+  readonly alreadyOpen: boolean
+}
+
+/** Open — or focus the live window for — one Xaihi document target the policy already accepted. */
+function openXaihiDocumentWindow (preload: string, target: string): XaihiWindowOpening {
+  const key = xaihiWindowKey(target)
+  const existing = xaihiDocumentWindows.get(key)
+  if (existing !== undefined && !existing.isDestroyed()) {
+    if (existing.isMinimized()) existing.restore()
+    existing.show()
+    existing.focus()
+    return { window: existing, alreadyOpen: true }
+  }
   const window = createWindow(preload, true, false)
-  xaihiDocumentWindows.add(window)
-  window.on('closed', () => { xaihiDocumentWindows.delete(window) })
+  window.setTitle(`Xaihi \u00b7 ${key}`)
+  xaihiDocumentWindows.set(key, window)
+  window.on('closed', () => { if (xaihiDocumentWindows.get(key) === window) xaihiDocumentWindows.delete(key) })
   void window.loadURL(target)
-  return window
+  return { window, alreadyOpen: false }
 }
 
