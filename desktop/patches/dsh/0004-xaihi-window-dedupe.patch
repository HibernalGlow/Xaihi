@@ -50,3 +50,14 @@ export function resolveXaihiDocumentTarget (request: XaihiWindowRequest): string
 function nodeValueAccepted (node: string): boolean {
   return NODE_VALUE.test(node)
 }
+
+/** The dedupe key for one Xaihi document window: the node it addresses, or the workbench itself. */
+export function xaihiWindowKey (url: string): string {
+  let parsed: URL
+  try {
+    parsed = new URL(url)
+  } catch {
+    return 'workspace'
+  }
+  return parsed.searchParams.get('node') ?? 'workspace'
+}
