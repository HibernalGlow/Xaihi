{
  "name": "@hibernalglow/xaihi-ui-kit",
  "version": "0.0.0",
  "description": "Material 3 \u89c2\u611f\u7684\u8282\u70b9\u9762\u677f\u7ec4\u4ef6\uff1a\u53ea\u5403 --xaihi-* \u522b\u540d\uff0c\u63d2\u4ef6\u4e0d\u8bb8\u81ea\u5e26\u989c\u8272\u3002",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./components": {
      "types": "./lib/components.d.ts",
      "default": "./lib/components.js"
    },
    "./md3e": {
      "types": "./lib/md3e.d.ts",
      "default": "./lib/md3e.js"
    },
    "./shapes": {
      "types": "./lib/shapes.d.ts",
      "default": "./lib/shapes.js"
    },
    "./tokens": {
      "types": "./lib/tokens.d.ts",
      "default": "./lib/tokens.js"
    },
    "./styles.css": "./lib/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "verify-pack": "node scripts/verify-pack.mjs",
    "clean": "rm -rf lib"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "happy-dom": "^20.10.6",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
