{
  "name": "@hibernalglow/xaihi-sdk",
  "version": "0.0.0",
  "description": "Contracts and node runtime helpers for Xaihi: xaihi.manifest/1, xaihi.node/v1 vocabulary and validators, the condition evaluator, defineNode's tool + danger wiring, and the UIModuleLoader interface that hides the module transport.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./operations": {
      "types": "./lib/operations.d.ts",
      "default": "./lib/operations.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rm -rf lib",
    "prepare": "tsdown"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
