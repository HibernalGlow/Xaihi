{
  "name": "@hibernalglow/xaihi-cli",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Aggregate Xiranite CLI that dispatches to installed node package commands.",
  "license": "UNLICENSED",
  "bin": {
    "xaihi": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tsc": "tsc -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "@hibernalglow/xaihi-api": "workspace:*",
    "@hibernalglow/xaihi-cli-runtime": "workspace:*",
    "@hibernalglow/xaihi-logging": "workspace:*",
    "@hibernalglow/xaihi-shared": "workspace:*",
    "@hibernalglow/xaihi-bandia": "workspace:*",
    "@hibernalglow/xaihi-cleanf": "workspace:*",
    "@hibernalglow/xaihi-crashu": "workspace:*",
    "@hibernalglow/xaihi-dissolvef": "workspace:*",
    "@hibernalglow/xaihi-encodeb": "workspace:*",
    "@hibernalglow/xaihi-enginev": "workspace:*",
    "@hibernalglow/xaihi-findz": "workspace:*",
    "@hibernalglow/xaihi-formatv": "workspace:*",
    "@hibernalglow/xaihi-linedup": "workspace:*",
    "@hibernalglow/xaihi-linku": "workspace:*",
    "@hibernalglow/xaihi-marku": "workspace:*",
    "@hibernalglow/xaihi-migratef": "workspace:*",
    "@hibernalglow/xaihi-mvz": "workspace:*",
    "@hibernalglow/xaihi-rawfilter": "workspace:*",
    "@hibernalglow/xaihi-recycleu": "workspace:*",
    "@hibernalglow/xaihi-repacku": "workspace:*",
    "@hibernalglow/xaihi-samea": "workspace:*",
    "@hibernalglow/xaihi-sleept": "workspace:*",
    "@hibernalglow/xaihi-trename": "workspace:*",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
