{
  "name": "@hibernalglow/create-xaihi-plugin",
  "version": "0.0.0",
  "description": "Scaffold a Xaihi node package: manifest, its own cordis.patch.yml, host tool wiring and a self-owned UI module.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "create-xaihi-plugin": "lib/index.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rm -rf lib"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
