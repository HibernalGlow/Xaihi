{
  "name": "@hibernalglow/xaihi-ui",
  "version": "0.0.0",
  "description": "Xaihi workspace host: occupies the harness main panel, declares xaihi.* slots, owns layout and theme bridging, and loads node UI through a swappable module loader.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "dist-ui/**",
    "locale/*.json",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-css.mjs && tsdown",
    "build:document": "rspack build -c rspack.document.mjs",
    "typecheck": "node ../../scripts/check-types.mjs",
    "typecheck:strict": "node ../../scripts/check-types.mjs --fail-on-all",
    "test:unit": "vitest run",
    "clean": "rm -rf lib"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@blocknote/core": "0.51.4",
    "@blocknote/shadcn": "0.51.4",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@diceui/tags-input": "0.7.2",
    "@dnd-kit/core": "6.3.1",
