{
  "name": "@hibernalglow/xaihi-migratef",
  "version": "0.0.0",
  "description": "Xaihi node MigrateF: backend actions plus a self-owned workspace panel.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./help": {
      "types": "./lib/help.d.ts",
      "default": "./lib/help.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "dist/**",
    "locale/*.json",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "xaihi": {
    "schema": "xaihi.manifest/1",
    "id": "xaihi-migratef",
    "title": {
      "zh": "MigrateF",
      "en": "MigrateF"
    },
    "ui": {
      "remote": "migratef",
      "entry": "./dist/remoteEntry.js"
    },
    "panels": [
      {
        "id": "xaihi.workspace.migratef",
        "title": {
          "zh": "MigrateF面板",
          "en": "MigrateF panel"
        },
        "area": "workspace",
        "remote": "migratef",
        "export": "Panel"
      }
    ],
    "node": {
      "definitionVersion": 1,
      "nodeId": "migratef",
      "title": {
        "zh": "MigrateF",
        "en": "MigrateF"
      },
      "description": {
        "zh": "以 preserve、flat、direct 三种模式移动或复制文件，并提供撤销历史。",
        "en": "Move or copy files with preserve, flat, and direct modes plus undo history."
      },
      "actions": [
        {
          "id": "plan",
          "label": {
            "zh": "⌁ 迁移计划",
            "en": "⌁ Plan"
          }
        },
        {
          "id": "move",
          "label": {
            "zh": "→ 移动",
            "en": "→ Move"
          }
        },
        {
          "id": "copy",
          "label": {
            "zh": "⧉ 复制",
            "en": "⧉ Copy"
          }
        },
        {
          "id": "history",
          "label": {
            "zh": "◷ 历史",
            "en": "◷ History"
          }
        },
        {
          "id": "undo",
          "label": {
            "zh": "↶ 撤销",
            "en": "↶ Undo"
          }
        }
      ],
      "fields": [
        {
          "id": "action",
          "label": {
            "zh": "操作",
            "en": "Action"
          },
          "kind": "select",
          "isActionSelector": true,
          "options": [
            {
              "value": "plan",
              "label": {
                "zh": "⌁ 迁移计划",
                "en": "⌁ Plan"
              }
            },
            {
              "value": "move",
              "label": {
                "zh": "→ 移动",
                "en": "→ Move"
              }
            },
            {
              "value": "copy",
              "label": {
                "zh": "⧉ 复制",
                "en": "⧉ Copy"
              }
            },
            {
              "value": "history",
              "label": {
                "zh": "◷ 历史",
                "en": "◷ History"
              }
            },
            {
              "value": "undo",
              "label": {
                "zh": "↶ 撤销",
                "en": "↶ Undo"
              }
            }
          ],
          "default": {
            "text": "plan"
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": [
            {
              "rule": {
                "type": "oneOfDeclaredOptions"
              }
            }
          ]
        },
        {
          "id": "mode",
          "label": {
            "zh": "目录模式",
            "en": "Layout mode"
          },
          "kind": "select",
          "options": [
            {
              "value": "preserve",
              "label": {
                "zh": "▦ 保留结构",
                "en": "▦ Preserve"
              }
            },
            {
              "value": "flat",
              "label": {
                "zh": "═ 扁平化",
                "en": "═ Flat"
              }
            },
            {
              "value": "direct",
              "label": {
                "zh": "→ 直接迁移",
                "en": "→ Direct"
              }
            }
          ],
          "default": {
            "text": "preserve"
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": true
            }
          },
          "rules": [
            {
              "rule": {
                "type": "oneOfDeclaredOptions"
              },
              "when": {
                "type": "single",
                "predicate": {
                  "test": {
                    "type": "actionIs",
                    "actionField": "action",
                    "allowed": [
                      "history",
                      "undo"
                    ]
                  },
                  "negated": true
                }
              }
            }
          ]
        },
        {
          "id": "sourcePaths",
          "label": {
            "zh": "来源路径",
            "en": "Source paths"
          },
          "kind": "text",
          "default": {
            "text": ""
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": true
            }
          },
          "rules": [
            {
              "rule": {
                "type": "atLeastLines",
                "minimum": 1
              },
              "when": {
                "type": "single",
                "predicate": {
                  "test": {
                    "type": "actionIs",
                    "actionField": "action",
                    "allowed": [
                      "history",
                      "undo"
                    ]
                  },
                  "negated": true
                }
              }
            }
          ]
        },
        {
          "id": "targetPath",
          "label": {
            "zh": "目标目录",
            "en": "Target path"
          },
          "kind": "text",
          "default": {
            "text": ""
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": true
            }
          },
          "rules": [
            {
              "rule": {
                "type": "required"
              },
              "when": {
                "type": "single",
                "predicate": {
                  "test": {
                    "type": "actionIs",
                    "actionField": "action",
                    "allowed": [
                      "history",
                      "undo"
                    ]
                  },
                  "negated": true
                }
              }
            },
            {
              "rule": {
                "type": "nonBlank"
              },
              "when": {
                "type": "single",
                "predicate": {
                  "test": {
                    "type": "actionIs",
                    "actionField": "action",
                    "allowed": [
                      "history",
                      "undo"
                    ]
                  },
                  "negated": true
                }
              }
            }
          ]
        },
        {
          "id": "maxWorkers",
          "label": {
            "zh": "并发数",
            "en": "Workers"
          },
          "kind": "number",
          "range": {
            "min": 1,
            "max": 64,
            "step": 1
          },
          "default": {
            "number": 16
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": true
            }
          },
          "rules": [
            {
              "rule": {
                "type": "integerInRange"
              },
              "when": {
                "type": "single",
                "predicate": {
                  "test": {
                    "type": "actionIs",
                    "actionField": "action",
                    "allowed": [
                      "history",
                      "undo"
                    ]
                  },
                  "negated": true
                }
              }
            }
          ]
        },
        {
          "id": "batchId",
          "label": {
            "zh": "批次 ID",
            "en": "Batch ID"
          },
          "kind": "text",
          "default": {
            "text": ""
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "undo"
                ]
              },
              "negated": false
            }
          },
          "rules": []
        },
        {
          "id": "historyLimit",
          "label": {
            "zh": "历史条数",
            "en": "History limit"
          },
          "kind": "number",
          "range": {
            "min": 1,
            "max": 100,
            "step": 1
          },
          "default": {
            "number": 10
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history"
                ]
              },
              "negated": false
            }
          },
          "rules": [
            {
              "rule": {
                "type": "integerInRange"
              }
            }
          ]
        },
        {
          "id": "historyPath",
          "label": {
            "zh": "历史文件",
            "en": "History file"
          },
          "kind": "text",
          "default": {
            "text": ""
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": false
            }
          },
          "rules": []
        },
        {
          "id": "dryRun",
          "label": {
            "zh": "仅预演",
            "en": "Dry run"
          },
          "kind": "boolean",
          "default": {
            "boolean": true
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history"
                ]
              },
              "negated": true
            }
          },
          "rules": []
        }
      ],
      "groups": [
        {
          "id": "migration",
          "fieldIds": [
            "action",
            "mode",
            "sourcePaths",
            "targetPath",
            "maxWorkers",
            "batchId",
            "historyLimit",
            "historyPath",
            "dryRun"
          ],
          "label": {
            "zh": "迁移配置",
            "en": "Migration"
          }
        }
      ],
      "inputBindings": [
        {
          "fieldId": "action",
          "slot": "action",
          "transform": "trim"
        },
        {
          "fieldId": "mode",
          "slot": "mode",
          "transform": "trim"
        },
        {
          "fieldId": "sourcePaths",
          "slot": "sourcePaths",
          "transform": "delimited"
        },
        {
          "fieldId": "targetPath",
          "slot": "targetPath",
          "transform": "identity"
        },
        {
          "fieldId": "maxWorkers",
          "slot": "maxWorkers",
          "transform": "asInteger"
        },
        {
          "fieldId": "batchId",
          "slot": "batchId",
          "transform": "identity"
        },
        {
          "fieldId": "historyLimit",
          "slot": "historyLimit",
          "transform": "asInteger"
        },
        {
          "fieldId": "historyPath",
          "slot": "historyPath",
          "transform": "identity"
        },
        {
          "fieldId": "dryRun",
          "slot": "dryRun",
          "transform": "asBoolean"
        }
      ],
      "danger": {
        "type": "pluginExport",
        "exportName": "is_dangerous"
      },
      "dangerPrompt": {
        "title": {
          "zh": "确认真实迁移",
          "en": "Confirm live migration"
        },
        "body": {
          "zh": "文件系统将被真实修改。",
          "en": "The filesystem will be modified."
        },
        "confirmLabel": {
          "zh": "确认执行",
          "en": "Execute"
        }
      },
      "previewExport": "preview",
      "resultExport": "result_view",
      "reportsProgress": true,
      "publishesOutputPath": false,
      "help": {
        "whenToUse": {
          "zh": "当需要从工作区 UI 或 CLI 使用该节点的文件工作流时，使用 MigrateF。",
          "en": "Use MigrateF when you need this node's file workflow from either the workspace UI or CLI."
        },
        "safety": {
          "defaultMode": "preview",
          "notes": {
            "zh": [
              "修改文件前优先使用预览或 dry-run 模式。",
              "处理大文件夹时保留备份或撤销记录。"
            ],
            "en": [
              "Prefer preview or dry-run modes before changing files.",
              "Keep backups or undo records when processing large folders."
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown && rspack build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rm -rf lib dist"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@hibernalglow/xaihi-sdk": "workspace:*",
    "@module-federation/enhanced": "2.9.2",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "bin": {
    "migratef": "./lib/cli.js"
  }
}
