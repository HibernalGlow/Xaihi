{
  "name": "@hibernalglow/xaihi-sleept",
  "version": "0.0.0",
  "description": "Xaihi node Sleep control: backend actions plus a self-owned workspace panel.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "dist/**",
    "locale/*.json",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "xaihi": {
    "schema": "xaihi.manifest/1",
    "id": "xaihi-sleept",
    "title": {
      "zh": "\u4f11\u7720\u7ba1\u7406",
      "en": "Sleep control"
    },
    "ui": {
      "remote": "sleept",
      "entry": "./dist/remoteEntry.js"
    },
    "panels": [
      {
        "id": "xaihi.workspace.sleept",
        "title": {
          "zh": "\u4f11\u7720\u7ba1\u7406\u9762\u677f",
          "en": "Sleep control panel"
        },
        "area": "workspace",
        "remote": "sleept",
        "export": "Panel"
      }
    ],
    "node": {
      "definitionVersion": 1,
      "nodeId": "sleept",
      "title": {
        "zh": "\u4f11\u7720\u7ba1\u7406",
        "en": "Sleep control"
      },
      "description": {
        "zh": "\u8bfb\u53d6\u672c\u673a\u7761\u7720/\u4f11\u7720\u8bbe\u7f6e\u4e0e\u8c01\u5728\u963b\u6b62\u4f11\u7720\uff0c\u4e34\u65f6\u963b\u6b62\u7cfb\u7edf\u4f11\u7720\uff0c\u6216\u8ba9\u673a\u5668\u7acb\u5373\u8fdb\u5165\u7761\u7720\uff08Windows \u53ef\u9009\u4f11\u7720\uff09\u3002\u4ec5\u8986\u76d6 macOS \u4e0e Windows\u3002",
        "en": "Read sleep/hibernate settings and which processes hold sleep off, temporarily prevent system sleep, or put the machine to sleep now (hibernate on Windows). Covers macOS and Windows only."
      },
      "actions": [
        {
          "id": "status",
          "label": {
            "zh": "\u8bfb\u53d6\u72b6\u6001",
            "en": "Read status"
          },
          "description": {
            "zh": "\u62a5\u544a\u7761\u7720/\u4f11\u7720\u7a7a\u95f2\u8d85\u65f6\u3001\u4f11\u7720\u662f\u5426\u542f\u7528\uff0c\u4ee5\u53ca\u5f53\u524d\u6b63\u5728\u963b\u6b62\u4f11\u7720\u7684\u8fdb\u7a0b\u3002",
            "en": "Report idle sleep/hibernate timeouts, whether hibernation is enabled, and which processes currently hold sleep off."
          }
        },
        {
          "id": "block",
          "label": {
            "zh": "\u963b\u6b62\u4f11\u7720",
            "en": "Prevent sleep"
          },
          "description": {
            "zh": "\u5728\u65f6\u957f\u5185\u963b\u6b62\u7cfb\u7edf\u4f11\u7720\uff1b\u5bbf\u4e3b\u9000\u51fa\u6216\u8c03\u7528 unblock \u65f6\u81ea\u52a8\u89e3\u9664\u3002",
            "en": "Prevent system sleep for the given duration; released by unblock or when the host exits."
          }
        },
        {
          "id": "unblock",
          "label": {
            "zh": "\u89e3\u9664\u963b\u6b62",
            "en": "Release hold"
          },
          "description": {
            "zh": "\u7ed3\u675f\u6301\u6709\u62e6\u622a\u7684\u5b50\u8fdb\u7a0b\uff0c\u628a\u7761\u7720\u4ea4\u8fd8\u7ed9\u7cfb\u7edf\u3002",
            "en": "Terminate the holding child and give sleep back to the system."
          }
        },
        {
          "id": "sleep",
          "label": {
            "zh": "\u7acb\u5373\u7761\u7720",
            "en": "Sleep now"
          },
          "description": {
            "zh": "\u8ba9\u673a\u5668\u7acb\u5373\u8fdb\u5165\u7761\u7720\u3002Windows \u4e0a allowHibernate=true \u6539\u4e3a\u4f11\u7720\u3002\u4f1a\u4e2d\u65ad\u4f7f\u7528\u8005\uff0c\u9700\u8981\u6279\u51c6\u3002",
            "en": "Put the machine to sleep immediately; on Windows allowHibernate=true hibernates instead. Interrupts whoever is at the keyboard, so it needs approval."
          }
        },
        {
          "id": "displayOff",
          "label": {
            "zh": "\u5173\u95ed\u5c4f\u5e55",
            "en": "Turn display off"
          },
          "description": {
            "zh": "\u53ea\u5173\u5c4f\u5e55\uff0c\u4e0d\u7761\u7720\uff1b\u4efb\u4f55\u8f93\u5165\u90fd\u4f1a\u628a\u5c4f\u5e55\u53eb\u9192\u3002",
            "en": "Turns the display off only; the system keeps running and any input wakes the screen."
          }
        },
        {
          "id": "screensaver",
          "label": {
            "zh": "\u8fdb\u5165\u5c4f\u4fdd",
            "en": "Start screensaver"
          },
          "description": {
            "zh": "\u7acb\u523b\u542f\u52a8\u5c4f\u4fdd\uff0c\u4e0d\u5f71\u54cd\u540e\u53f0\u4efb\u52a1\u3002",
            "en": "Starts the screensaver immediately; background work keeps running."
          }
        }
      ],
      "fields": [
        {
          "id": "action",
          "kind": "select",
          "isActionSelector": true,
          "label": {
            "zh": "\u52a8\u4f5c",
            "en": "Action"
          },
          "options": [
            {
              "value": "status",
              "label": {
                "zh": "\u8bfb\u53d6\u72b6\u6001",
                "en": "Read status"
              }
            },
            {
              "value": "block",
              "label": {
                "zh": "\u963b\u6b62\u4f11\u7720",
                "en": "Prevent sleep"
              }
            },
            {
              "value": "unblock",
              "label": {
                "zh": "\u89e3\u9664\u963b\u6b62",
                "en": "Release hold"
              }
            },
            {
              "value": "sleep",
              "label": {
                "zh": "\u7acb\u5373\u7761\u7720",
                "en": "Sleep now"
              }
            },
            {
              "value": "displayOff",
              "label": {
                "zh": "\u5173\u95ed\u5c4f\u5e55",
                "en": "Turn display off"
              }
            },
            {
              "value": "screensaver",
              "label": {
                "zh": "\u8fdb\u5165\u5c4f\u4fdd",
                "en": "Start screensaver"
              }
            }
          ]
        },
        {
          "id": "minutes",
          "kind": "number",
          "label": {
            "zh": "\u963b\u6b62\u65f6\u957f\uff08\u5206\u949f\uff09",
            "en": "Hold duration (minutes)"
          },
          "description": {
            "zh": "\u7701\u7565\u65f6\u7528\u63d2\u4ef6\u914d\u7f6e\u91cc\u7684\u9ed8\u8ba4\u503c\u3002\u5230\u671f\u540e\u62e6\u622a\u968f\u5b50\u8fdb\u7a0b\u4e00\u8d77\u7ed3\u675f\u3002",
            "en": "Falls back to the plugin config default. The hold ends with its child when the time is up."
          },
          "rules": [
            {
              "type": "integerAtLeast",
              "minimum": 1
            }
          ],
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "allowed": [
                  "block"
                ]
              },
              "negated": false
            }
          }
        },
        {
          "id": "allowHibernate",
          "kind": "boolean",
          "label": {
            "zh": "\u4f11\u7720\u800c\u975e\u7761\u7720\uff08\u4ec5 Windows\uff09",
            "en": "Hibernate instead of sleep (Windows only)"
          },
          "description": {
            "zh": "Windows \u4e0a\u4f11\u7720\u5f00\u7740\u65f6\uff0c\u8d70 rundll32 \u7684 bHibernate=false \u4f1a\u628a\u7761\u7720\u7761\u6210\u4f11\u7720\uff1b\u672c\u673a\u4f11\u7720\u88ab\u7981\u7528\u65f6\u6b64\u9009\u9879\u4f1a\u88ab\u62d2\u7edd\u800c\u4e0d\u662f\u4ec0\u4e48\u90fd\u4e0d\u505a\u3002",
            "en": "On Windows the classic rundll32 path turns 'sleep' into hibernation while hibernation is enabled; this option is refused outright when hibernation is off, rather than silently doing nothing."
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "allowed": [
                  "sleep"
                ]
              },
              "negated": false
            }
          }
        }
      ],
      "groups": [
        {
          "id": "main",
          "label": {
            "zh": "\u7535\u6e90",
            "en": "Power"
          },
          "fieldIds": [
            "action",
            "minutes",
            "allowHibernate"
          ]
        }
      ],
      "inputBindings": [
        {
          "fieldId": "action",
          "slot": "action",
          "transform": "identity"
        },
        {
          "fieldId": "minutes",
          "slot": "minutes",
          "transform": "asInteger",
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "allowed": [
                  "block"
                ]
              },
              "negated": false
            }
          }
        },
        {
          "fieldId": "allowHibernate",
          "slot": "allowHibernate",
          "transform": "asBoolean",
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "allowed": [
                  "sleep"
                ]
              },
              "negated": false
            }
          }
        }
      ],
      "danger": {
        "type": "actionIn",
        "actionField": "action",
        "dangerous": [
          "sleep"
        ]
      },
      "resultExport": "result_view",
      "reportsProgress": false,
      "publishesOutputPath": false,
      "help": {
        "whenToUse": {
          "zh": "\u8981\u4e34\u65f6\u4fdd\u4f4f\u4e00\u53f0\u673a\u5668\u4e0d\u7761\uff08\u8dd1\u957f\u4efb\u52a1\uff09\u3001\u6216\u60f3\u77e5\u9053\u662f\u8c01\u628a\u7761\u7720\u62e6\u4e0b\u6765\u7684\u65f6\u5019\u7528\u3002",
          "en": "Use it to keep a machine awake for a while, or to find out who is holding sleep off."
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown && rspack build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rm -rf lib dist"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@hibernalglow/xaihi-sdk": "workspace:*",
    "@module-federation/enhanced": "2.9.2",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
