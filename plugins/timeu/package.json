{
  "name": "@hibernalglow/xaihi-timeu",
  "version": "0.0.0",
  "description": "Xaihi node TimeU: backend actions plus a self-owned workspace panel.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./help": {
      "types": "./lib/help.d.ts",
      "default": "./lib/help.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "xtimeu": "./lib/cli.js"
  },
  "files": [
    "lib/**",
    "dist/**",
    "locale/*.json",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "xaihi": {
    "schema": "xaihi.manifest/1",
    "id": "xaihi-timeu",
    "title": {
      "zh": "TimeU",
      "en": "TimeU"
    },
    "ui": {
      "remote": "timeu",
      "entry": "./dist/remoteEntry.js"
    },
    "panels": [
      {
        "id": "xaihi.workspace.timeu",
        "title": {
          "zh": "TimeU面板",
          "en": "TimeU panel"
        },
        "area": "workspace",
        "remote": "timeu",
        "export": "Panel"
      }
    ],
    "node": {
      "definitionVersion": 1,
      "nodeId": "timeu",
      "title": {
        "zh": "TimeU",
        "en": "TimeU"
      },
      "description": {
        "zh": "从 JSON 记录备份和恢复文件时间戳。",
        "en": "Back up and restore file timestamps from JSON records."
      },
      "actions": [
        {
          "id": "scan",
          "label": {
            "zh": "检查",
            "en": "Scan"
          }
        },
        {
          "id": "backup",
          "label": {
            "zh": "备份时间戳",
            "en": "Back up"
          }
        },
        {
          "id": "restore",
          "label": {
            "zh": "恢复时间戳",
            "en": "Restore"
          }
        }
      ],
      "fields": [
        {
          "id": "action",
          "label": {
            "zh": "操作",
            "en": "Action"
          },
          "kind": "select",
          "options": [
            {
              "value": "scan",
              "label": {
                "zh": "检查",
                "en": "Scan"
              }
            },
            {
              "value": "backup",
              "label": {
                "zh": "备份时间戳",
                "en": "Back up"
              }
            },
            {
              "value": "restore",
              "label": {
                "zh": "恢复时间戳",
                "en": "Restore"
              }
            }
          ],
          "default": {
            "text": "scan"
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": [
            {
              "rule": {
                "type": "oneOfDeclaredOptions"
              }
            }
          ],
          "isActionSelector": true
        },
        {
          "id": "listText",
          "label": {
            "zh": "路径队列",
            "en": "Path queue"
          },
          "kind": "path-list",
          "lines": 7,
          "placeholder": {
            "zh": "每行一个文件或目录",
            "en": "One file or directory per line"
          },
          "default": {
            "text": ""
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": [
            {
              "rule": {
                "type": "nonBlank"
              }
            }
          ]
        },
        {
          "id": "recordPath",
          "label": {
            "zh": "时间记录文件",
            "en": "Timestamp record file"
          },
          "kind": "text",
          "placeholder": {
            "zh": "timeu-timestamps.json",
            "en": "timeu-timestamps.json"
          },
          "default": {
            "text": ""
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": []
        },
        {
          "id": "recursive",
          "label": {
            "zh": "递归目录",
            "en": "Recurse directories"
          },
          "kind": "boolean",
          "default": {
            "boolean": true
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": []
        },
        {
          "id": "includeDirectories",
          "label": {
            "zh": "包含目录自身",
            "en": "Include directories"
          },
          "kind": "boolean",
          "default": {
            "boolean": false
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": []
        },
        {
          "id": "dryRun",
          "label": {
            "zh": "预演模式",
            "en": "Dry-run"
          },
          "kind": "boolean",
          "default": {
            "boolean": true
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "allowed": [
                  "scan"
                ]
              },
              "negated": true
            }
          },
          "rules": []
        }
      ],
      "groups": [],
      "inputBindings": [
        {
          "fieldId": "action",
          "slot": "action",
          "transform": "trim"
        },
        {
          "fieldId": "listText",
          "slot": "listText",
          "transform": "identity"
        },
        {
          "fieldId": "recordPath",
          "slot": "recordPath",
          "transform": "trimOrOmit"
        },
        {
          "fieldId": "recursive",
          "slot": "recursive",
          "transform": "asBoolean"
        },
        {
          "fieldId": "includeDirectories",
          "slot": "includeDirectories",
          "transform": "asBoolean"
        },
        {
          "fieldId": "dryRun",
          "slot": "dryRun",
          "transform": "asBoolean"
        }
      ],
      "danger": {
        "type": "all",
        "predicates": [
          {
            "test": {
              "type": "actionIs",
              "allowed": [
                "scan"
              ]
            },
            "negated": true
          },
          {
            "test": {
              "type": "fieldTrue",
              "fieldId": "dryRun"
            },
            "negated": true
          }
        ]
      },
      "previewExport": "preview",
      "resultExport": "result_view",
      "reportsProgress": true,
      "publishesOutputPath": false,
      "help": {
        "whenToUse": {
          "zh": "在归档移动、重命名或恢复任务前，需要保留文件的修改/访问时间时使用 TimeU。",
          "en": "Use TimeU before archive moves, renames, or recovery jobs when file modified/accessed times must be preserved."
        },
        "safety": {
          "defaultMode": "preview",
          "notes": {
            "zh": [
              "默认开启试运行。",
              "创建和变更时间仅作为参考记录；原生运行时只恢复访问和修改时间。",
              "缺失路径会被报告并跳过。"
            ],
            "en": [
              "Dry-run is enabled by default.",
              "Birth and change times are recorded for reference; the native runtime restores access and modified times.",
              "Missing paths are reported and skipped."
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown && rspack build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rm -rf lib dist"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@hibernalglow/xaihi-sdk": "workspace:*",
    "@module-federation/enhanced": "2.9.2",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
