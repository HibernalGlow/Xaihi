{
  "name": "@hibernalglow/xaihi-formatv",
  "version": "0.0.0",
  "description": "Xaihi node FormatV: backend actions plus a self-owned workspace panel.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./help": {
      "types": "./lib/help.d.ts",
      "default": "./lib/help.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "formatv": "./lib/cli.js"
  },
  "files": [
    "lib/**",
    "dist/**",
    "locale/*.json",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "xaihi": {
    "schema": "xaihi.manifest/1",
    "id": "xaihi-formatv",
    "title": {
      "zh": "FormatV",
      "en": "FormatV"
    },
    "ui": {
      "remote": "formatv",
      "entry": "./dist/remoteEntry.js"
    },
    "panels": [
      {
        "id": "xaihi.workspace.formatv",
        "title": {
          "zh": "FormatV面板",
          "en": "FormatV panel"
        },
        "area": "workspace",
        "remote": "formatv",
        "export": "Panel"
      }
    ],
    "node": {
      "definitionVersion": 1,
      "nodeId": "formatv",
      "title": {
        "zh": "FormatV",
        "en": "FormatV"
      },
      "description": {
        "zh": "扫描视频文件夹，添加/移除 .nov 后缀，并检查带前缀的重复项。",
        "en": "Scan video folders, add/remove .nov suffixes, and check prefixed duplicates."
      },
      "actions": [
        {
          "id": "scan",
          "label": {
            "zh": "扫描",
            "en": "Scan"
          }
        },
        {
          "id": "add_nov",
          "label": {
            "zh": "添加 .nov",
            "en": "Add .nov"
          }
        },
        {
          "id": "remove_nov",
          "label": {
            "zh": "移除 .nov",
            "en": "Remove .nov"
          }
        },
        {
          "id": "check_duplicates",
          "label": {
            "zh": "检查重复",
            "en": "Duplicates"
          }
        }
      ],
      "fields": [
        {
          "id": "action",
          "label": {
            "zh": "操作",
            "en": "Action"
          },
          "kind": "select",
          "isActionSelector": true,
          "options": [
            {
              "value": "scan",
              "label": {
                "zh": "扫描",
                "en": "Scan"
              }
            },
            {
              "value": "add_nov",
              "label": {
                "zh": "添加 .nov",
                "en": "Add .nov"
              }
            },
            {
              "value": "remove_nov",
              "label": {
                "zh": "移除 .nov",
                "en": "Remove .nov"
              }
            },
            {
              "value": "check_duplicates",
              "label": {
                "zh": "检查重复",
                "en": "Duplicates"
              }
            }
          ],
          "default": {
            "text": "scan"
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": [
            {
              "rule": {
                "type": "oneOfDeclaredOptions"
              }
            }
          ]
        },
        {
          "id": "pathsText",
          "label": {
            "zh": "视频路径",
            "en": "Video paths"
          },
          "kind": "path-list",
          "lines": 5,
          "placeholder": {
            "zh": "每行一个文件夹或文件",
            "en": "One folder or file per line"
          },
          "default": {
            "text": ""
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": [
            {
              "rule": {
                "type": "atLeastLines",
                "minimum": 1
              }
            }
          ]
        },
        {
          "id": "recursive",
          "label": {
            "zh": "递归扫描",
            "en": "Recursive scan"
          },
          "kind": "boolean",
          "default": {
            "boolean": false
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": []
        },
        {
          "id": "prefixName",
          "label": {
            "zh": "前缀名称",
            "en": "Prefix name"
          },
          "kind": "text",
          "default": {
            "text": "hb"
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": []
        },
        {
          "id": "reportPath",
          "label": {
            "zh": "重复报告路径",
            "en": "Duplicate report path"
          },
          "kind": "text",
          "default": {
            "text": ""
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": []
        },
        {
          "id": "dryRun",
          "label": {
            "zh": "预演",
            "en": "Dry-run"
          },
          "kind": "boolean",
          "default": {
            "boolean": true
          },
          "visible": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "always"
              },
              "negated": false
            }
          },
          "rules": []
        }
      ],
      "groups": [],
      "inputBindings": [
        {
          "fieldId": "action",
          "slot": "action",
          "transform": "trim"
        },
        {
          "fieldId": "pathsText",
          "slot": "paths",
          "transform": "delimited"
        },
        {
          "fieldId": "recursive",
          "slot": "recursive",
          "transform": "asBoolean"
        },
        {
          "fieldId": "prefixName",
          "slot": "prefixName",
          "transform": "trim"
        },
        {
          "fieldId": "reportPath",
          "slot": "reportPath",
          "transform": "trimOrOmit"
        },
        {
          "fieldId": "dryRun",
          "slot": "dryRun",
          "transform": "asBoolean"
        }
      ],
      "danger": {
        "type": "all",
        "predicates": [
          {
            "test": {
              "type": "actionIs",
              "allowed": [
                "add_nov",
                "remove_nov"
              ]
            },
            "negated": false
          },
          {
            "test": {
              "type": "fieldTrue",
              "fieldId": "dryRun"
            },
            "negated": true
          }
        ]
      },
      "dangerPrompt": {
        "title": {
          "zh": "确认重命名",
          "en": "Confirm rename"
        },
        "body": {
          "zh": "将执行添加/移除 .nov 后缀。",
          "en": "Files will be renamed to add/remove the .nov suffix."
        },
        "confirmLabel": {
          "zh": "确认执行",
          "en": "Run now"
        }
      },
      "previewExport": "preview",
      "resultExport": "result_view",
      "reportsProgress": true,
      "publishesOutputPath": false,
      "resultTable": {
        "columns": [
          {
            "id": "sourcePath",
            "label": {
              "zh": "来源",
              "en": "Source"
            },
            "width": 40
          },
          {
            "id": "targetPath",
            "label": {
              "zh": "目标",
              "en": "Target"
            },
            "width": 40
          },
          {
            "id": "status",
            "label": {
              "zh": "状态",
              "en": "Status"
            },
            "width": 12
          }
        ]
      },
      "help": {
        "whenToUse": {
          "zh": "需要在工作区 UI 或 CLI 中使用该节点的视频工作流时，使用 FormatV。",
          "en": "Use FormatV when you need this node's video workflow from either the workspace UI or CLI."
        },
        "safety": {
          "defaultMode": "preview",
          "notes": {
            "zh": [
              "在修改文件前，优先使用预览或 dry-run 模式。",
              "处理大文件夹时请保留备份或撤销记录。"
            ],
            "en": [
              "Prefer preview or dry-run modes before changing files.",
              "Keep backups or undo records when processing large folders."
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown && rspack build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rm -rf lib dist"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@hibernalglow/xaihi-sdk": "workspace:*",
    "@module-federation/enhanced": "2.9.2",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
